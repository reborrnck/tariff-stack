---
import SeoHead from '../components/SeoHead.astro';
import sample from '../data/tariff_sample.json';
import overlay from '../data/policy_overlay.json';
import full from '../data/tariff_full.json';
import cnFullJson from '../data/tariff_full_cn.json';
import { computeStack, type Rate } from '../lib/calc.ts';
import { destLabel } from '../lib/destinations.ts';
import { ORIGINS, destOptionsFor, US_EMBARGOED } from '../lib/origins.ts';
import { t, originLabel, productName, PRODUCTS, LANGS } from '../lib/i18n.ts';
import newsFeed from '../data/news_feed.json';
import CookieConsent from '../components/CookieConsent.astro';

const rates = sample.rates;
const fixed = sample.fixed;

const COMPARE_ORIGINS = ['US','CN','MX','CA','DE','FR','IT','ES','NL','IE','PL','SE','BE','AT','PT','FI','DK','GR','GB','JP','KR','IN','VN','TH','TW','MY','ID','PH','SG','BD','PK','BR','AR','AU','NZ','CH','TR','ZA','SA','AE','IL'];
const COMPARE_ORIGINS_US = COMPARE_ORIGINS.filter(o => o !== 'US');
const PINNED_ORIGINS = ['US', 'CN'];
const POPULAR_ORIGINS = COMPARE_ORIGINS.filter(o => o !== 'US' && o !== 'CN');
const _popularSet = new Set(POPULAR_ORIGINS);
const _restOrigins = ORIGINS.filter(o => !_popularSet.has(o.iso2) && !PINNED_ORIGINS.includes(o.iso2));
const destOpts = destOptionsFor('CN');

const DEMO_HTS = '6109.10.00';
const fullRates = (full && typeof full === 'object') ? (full as Record<string, Rate>) : {};
const demoRates = fullRates[DEMO_HTS] ? fullRates : (rates as Record<string, Rate>);

const products = PRODUCTS;
const newsItems = (newsFeed && (newsFeed as { items?: any[] }).items) ? (newsFeed as { items: any[] }).items : [];
const DEFAULT_DEST = 'US';
const worked = computeStack(DEFAULT_DEST, DEMO_HTS, 'CN', 1000, demoRates, fixed, overlay)!;
const compare = COMPARE_ORIGINS_US.map(o => computeStack('US', DEMO_HTS, o, 1000, demoRates, fixed, overlay)!);

const cnFullRates = (cnFullJson && (cnFullJson as any).by_hs8) ? (cnFullJson as any).by_hs8 : (cnFullJson as any);
const COMPARE_ORIGINS_CN = COMPARE_ORIGINS.filter(o => o !== 'CN');
const compare_cn = COMPARE_ORIGINS_CN.map(o => computeStack('CN', '6109.10', o, 1000, demoRates, fixed, overlay, cnFullRates)!);

const verifiedDate = String(overlay.last_checked || overlay.as_of || '').slice(0, 10);
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "TariffStack — Import Duty & Landed-Cost Calculator",
  "applicationCategory": "FinanceApplication",
  "applicationSubCategory": "CustomsDutyCalculator",
  "operatingSystem": "Any",
  "inLanguage": ["en", "zh", "zh-TW", "ja", "ko", "es", "fr", "pt", "de", "it"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "description": "Free import duty and landed-cost calculator with multi-language UI and product-to-HS classification. U.S. full official stacked tariff (USITC HTS, subheading-level) is live; China destination official 2026 tariff schedule (State Council Tariff Commission, effective 2026-01-01) is live with REAL rates (最惠国/MFN + 暂定/provisional).",
  "dateModified": verifiedDate
});

const pct = (x: number) => (x * 100).toFixed(2) + '%';
const usd = (x: number) => '$' + x.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const effClass = (e: number) => (e > 0.3 ? 'bad' : e > 0.15 ? 'warn' : 'good');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>TariffStack — Import Duty &amp; Landed-Cost Calculator</title>
  <meta name="description" content={`Free import duty and landed-cost calculator with multi-language UI and product-to-HS classification. U.S. full official stacked tariff (USITC HTS, subheading-level) is live; China destination official 2026 tariff schedule (State Council Tariff Commission, effective 2026-01-01) is live with REAL rates. Verified ${verifiedDate} (Beijing time).`} />
  <script type="application/ld+json" set:html={jsonLd}></script>
  <SeoHead />
  <style is:global>
    :root{
      --bg:#f4f6fb; --card:#fff; --text:#1a2233; --muted:#5b6678; --content:#334155;
      --accent:#2f6df0; --accent-soft:#e8f0ff; --border:#e2e8f2; --line:#e6eaf1; --line2:#d7dde8;
      --good:#10b981; --warn:#f59e0b; --bad:#ef4444; --ink:#0f172a; --ink-deep:#0b1220;
      --scroll-thumb:#c8d0dd; --scroll-thumb-hover:#a8b3c5; --scroll-track:transparent;
    }
    [data-theme="dark"]{
      --bg:#0e1320; --card:#161e30; --text:#e6ebf5; --muted:#9aa6bd; --content:#c4cedb;
      --accent:#8aa7d8; --accent-soft:#1a2740; --border:#243049; --line:#1e2a3e; --line2:#2b3a52;
      --good:#6fbf9c; --warn:#d8a866; --bad:#d88686; --ink:#e8edf6; --ink-deep:#f4f8fd;
      --scroll-thumb:#2b3a52; --scroll-thumb-hover:#3d5070;
    }
    *{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:var(--scroll-thumb) var(--scroll-track);}
    *::-webkit-scrollbar{width:10px;height:10px;}
    *::-webkit-scrollbar-track{background:var(--scroll-track);}
    *::-webkit-scrollbar-thumb{background:var(--scroll-thumb);border-radius:10px;border:2px solid transparent;background-clip:padding-box;}
    *::-webkit-scrollbar-thumb:hover{background:var(--scroll-thumb-hover);background-clip:padding-box;}
    *::-webkit-scrollbar-corner{background:transparent;}
    body{margin:0;font:15px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"PingFang SC","Microsoft YaHei",Arial,sans-serif;
      background:var(--bg);color:var(--content);-webkit-font-smoothing:antialiased;}
    a{color:var(--accent);}
    .mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-variant-numeric:tabular-nums;}

    /* ===== 页头：纤细、整条底边带弧、吸顶 ===== */
    header{background:var(--card);border-radius:0 0 30px 30px;box-shadow:0 1px 2px rgba(20,30,60,.06),0 8px 24px rgba(20,30,60,.07);
      position:sticky;top:0;z-index:30;border-bottom:1px solid var(--border);}
    .hd-inner{max-width:1180px;margin:0 auto;padding:0 24px;display:flex;align-items:center;gap:14px;height:64px;}
    .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px;color:var(--ink);letter-spacing:.2px;text-decoration:none;}
    .brand .logo{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,var(--accent),#7aa7ff);display:grid;place-items:center;color:#fff;font-size:15px;box-shadow:0 4px 12px rgba(47,109,240,.35)}
    .spacer{flex:1}
    .lang-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
    .hbtn{display:inline-flex !important;align-items:center;gap:7px;height:40px;padding:0 16px;border-radius:999px;border:1px solid var(--border);
      background:var(--card);color:var(--text);font-size:14px;cursor:pointer;transition:.15s;white-space:nowrap;text-decoration:none;visibility:visible !important;}
    .hbtn:hover{box-shadow:0 1px 2px rgba(20,30,60,.06),0 8px 24px rgba(20,30,60,.07);transform:translateY(-1px);}
    .hbtn.active{background:var(--accent);border-color:var(--accent);color:#fff;}
    .hbtn.icon{width:40px;padding:0;justify-content:center;}
    .hsep{width:1px;height:24px;background:var(--border);margin:0 2px;}
    select#lang{height:40px;border-radius:999px;border:1px solid var(--border);background:var(--card);color:var(--text);padding:0 12px;font-size:14px;cursor:pointer;}
    @media (max-width:1280px){.hbtn{padding:0 12px;font-size:13.5px;}}
    @media (max-width:1100px){.hbtn{padding:0 10px;font-size:13px;}select#lang{padding:0 8px;font-size:13px;}}
    @media (max-width:900px){.hd-inner{gap:8px;padding:0 16px;}}

    /* ===== layout ===== */
    main{max-width:1180px;margin:0 auto;padding:24px 24px 40px;}
    .cols{display:grid;grid-template-columns:1.12fr .88fr;gap:22px;align-items:start;}
    @media(max-width:900px){.cols{grid-template-columns:1fr;}}
    h2.sec{margin:0 0 14px;font-size:21px;font-weight:700;color:var(--ink);letter-spacing:-.01em;}
    .sec-sub{font-size:14px;color:var(--muted);margin:0 0 14px;line-height:1.5;}
    .card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:22px;box-shadow:0 1px 2px rgba(20,30,60,.04);}
    .card .pad{padding:22px;}

    /* ===== hero ===== */
    .hero{padding:30px 0 6px;}
    .hero h1{font-size:32px;margin:0 0 10px;line-height:1.15;color:var(--ink);}
    .hero .sub{color:var(--muted);max-width:660px;margin:0 0 16px;}
    .verified{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);background:var(--card);border:1px solid var(--border);border-radius:999px;padding:6px 14px;box-shadow:0 1px 2px rgba(20,30,60,.06);}
    .verified .dot{width:8px;height:8px;border-radius:50%;background:var(--good);box-shadow:0 0 0 4px color-mix(in srgb,var(--good) 22%,transparent);}
    /* 变动预警横幅（匿名，免登录） */
    .alerts{margin:18px 0 0;display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:14px;background:var(--accent-soft);border:1px solid color-mix(in srgb,var(--accent) 30%,var(--border));font-size:14px;color:var(--content);}
    .alerts .pulse{width:10px;height:10px;border-radius:50%;background:var(--warn);position:relative;flex:none;}
    .alerts .pulse::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:2px solid var(--warn);animation:pulse 1.8s ease-out infinite;opacity:0;}
    @keyframes pulse{0%{transform:scale(.6);opacity:.7}100%{transform:scale(1.6);opacity:0}}

    /* ===== calculator form ===== */
    .calc{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;align-items:end;}
    .entry{display:flex;flex-direction:column;gap:7px;min-width:0;}
    label.fld{font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:600;}
    input,select{background:var(--card);color:var(--text);border:1px solid var(--line2);border-radius:10px;padding:11px 12px;font-size:15px;width:100%;max-width:100%;min-width:0;}
    input:focus,select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft);}
    button.btn{background:var(--accent);color:#fff;border:0;border-radius:10px;padding:12px 18px;font-size:15px;font-weight:700;cursor:pointer;text-align:center;width:100%;}
    button.btn:hover{filter:brightness(1.06);}
    .note{font-size:13.5px;color:var(--muted);margin-top:10px;line-height:1.6;}

    /* HS 自动补全下拉（可输入也可点选） */
    .hs-wrap{position:relative;}
    .hs-list{position:absolute;top:46px;left:0;right:0;background:var(--card);border:1px solid var(--border);border-radius:10px;box-shadow:0 2px 4px rgba(20,30,60,.08),0 14px 40px rgba(20,30,60,.12);max-height:248px;overflow-y:auto;z-index:25;display:none;}
    .hs-list.show{display:block;}
    .hs-list .opt{display:flex;gap:10px;padding:9px 12px;cursor:pointer;font-size:13px;align-items:baseline;}
    .hs-list .opt:hover,.hs-list .opt.active{background:var(--accent-soft);}
    .hs-list .opt .c{font-family:ui-monospace,Menlo,monospace;color:var(--accent);font-weight:700;min-width:90px;flex:none;}
    .hs-list .opt .d{color:var(--muted);}
    .hs-list .opt.none{color:var(--muted);cursor:default;}

    /* ===== 结果区：限高 + 滑轮 + 关税合计标识 ===== */
    .result{max-height:380px;overflow-y:auto;margin-top:16px;border-top:1px dashed var(--border);padding-top:14px;}
    .result::-webkit-scrollbar{width:10px;}
    .result::-webkit-scrollbar-thumb{background:var(--border);border-radius:8px;border:2px solid var(--bg);}
    .result::-webkit-scrollbar-track{background:transparent;}
    .total-box{display:flex;align-items:baseline;gap:12px;padding:14px 16px;border-radius:12px;background:var(--accent-soft);border:1px solid color-mix(in srgb,var(--accent) 35%,var(--border));margin-bottom:14px;}
    .total-box .lbl{font-size:13px;color:var(--muted);font-weight:600;}
    .total-box .amt{font-family:ui-monospace,Menlo,monospace;font-size:28px;font-weight:800;color:var(--accent);letter-spacing:-.5px;}
    .total-box .sub{font-size:12px;color:var(--muted);margin-left:auto;}
    .res-hero{display:flex;flex-direction:row;align-items:baseline;gap:40px;flex-wrap:wrap;margin:0 0 6px;padding:14px 18px;background:var(--accent-soft);border:1px solid color-mix(in srgb,var(--accent) 22%,var(--border));border-radius:14px;}
    .res-hero .h-label{font-size:15px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:700;}
    .res-hero .h-num{font-size:40px;line-height:1;font-weight:800;color:var(--accent);font-variant-numeric:tabular-nums;}
    .res-hero .h-num.good{color:var(--good);} .res-hero .h-num.warn{color:var(--warn);} .res-hero .h-num.bad{color:var(--bad);}
    .res-hero .h-total-label{font-size:16px;color:var(--content);font-weight:700;}
    .res-hero .h-total-num{font-size:40px;line-height:1;font-weight:800;color:var(--ink-deep);font-variant-numeric:tabular-nums;letter-spacing:-.01em;margin-left:auto;}
    .empty{color:var(--muted);font-style:italic;font-size:14px;padding:8px 0;}

    /* ===== classifier ===== */
    .cls-head{font-size:18px;font-weight:700;color:var(--ink);margin:0 0 6px;}
    .cls-sub{font-size:14px;color:var(--content);margin:0 0 14px;line-height:1.55;}
    .cls-row{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:end;margin-top:16px;}
    .matches{margin-top:16px;display:flex;flex-direction:column;gap:10px;width:100%;box-sizing:border-box;}
    .match{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;width:100%;box-sizing:border-box;text-align:left;
      background:var(--card);border:1px solid var(--border);border-radius:10px;padding:13px 15px;cursor:pointer;}
    .match:hover{border-color:var(--accent);background:var(--accent-soft);}
    .match .m-hts{flex:0 0 auto;font-weight:700;color:var(--accent);font-size:15px;font-variant-numeric:tabular-nums;}
    .match .m-desc{color:var(--content);font-size:14px;flex:1 1 auto;padding:0 14px;}
    .match .m-rate{flex:0 0 auto;font-size:13px;color:var(--muted);white-space:nowrap;}

    /* ===== tables ===== */
    table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;}
    th,td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--border);font-size:14.5px;color:var(--content);}
    th{color:var(--muted);font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.05em;background:var(--bg);}
    [data-theme="dark"] th{background:var(--card);}
    tr:last-child td{border-bottom:0;}
    td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;}
    .total td{font-weight:800;color:var(--ink);border-top:2px solid var(--line2);}
    .bad{color:var(--bad);font-weight:700;} .good{color:var(--good);font-weight:700;} .warn{color:var(--warn);font-weight:700;}
    .by-origin-scroll{max-height:340px;overflow-y:auto;margin-top:4px;border:1px solid var(--border);border-radius:12px;background:var(--card);}
    .by-origin-scroll table{border:0;border-radius:0;}
    .by-origin-scroll thead th{position:sticky;top:0;background:var(--bg);z-index:2;box-shadow:inset 0 -1px 0 var(--border);}

    /* ===== export ===== */
    .export{margin-top:16px;display:flex;gap:12px;flex-wrap:wrap;}
    .export button{background:var(--card);color:var(--text);border:1px solid var(--line2);border-radius:9px;padding:10px 16px;font-size:14px;font-weight:600;cursor:pointer;}
    .export button:hover{border-color:var(--accent);color:var(--accent);}

    /* ===== 近期变动 时间线（唯一政策呈现） ===== */
    .timeline{margin-top:8px;}
    .tl{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid var(--border);}
    .tl:last-child{border-bottom:none;}
    .tl .date{font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--muted);min-width:78px;}
    .tl .body{font-size:14px;color:var(--content);}
    .tl .tag{display:inline-block;font-size:11px;padding:2px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent);margin-right:8px;font-weight:700;}

    /* ===== 批量：自动待算行 ===== */
    .batch{margin-top:24px;}
    .binput{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr .9fr;gap:10px;align-items:end;}
    @media(max-width:820px){.binput{grid-template-columns:1fr 1fr;}}
    .binput .grow{grid-column:1/-1;}
    .pending{margin:12px 0 4px;display:flex;flex-direction:column;gap:8px;max-height:260px;overflow-y:auto;}
    .pending::-webkit-scrollbar{width:10px;}
    .pending::-webkit-scrollbar-thumb{background:var(--border);border-radius:8px;border:2px solid var(--bg);}
    .area-head{display:flex;align-items:center;justify-content:space-between;margin:4px 0 8px;}
    .area-head .t{font-size:13px;color:var(--muted);font-weight:600;}
    .clear-btn{height:30px;padding:0 12px;border-radius:8px;border:1px solid var(--border);background:var(--card);color:var(--muted);font-size:12.5px;cursor:pointer;}
    .clear-btn:hover{color:var(--bad);border-color:var(--bad);}
    .prow{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr .9fr 30px;gap:10px;align-items:center;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:8px 10px;font-size:13px;}
    [data-theme="dark"] .prow{background:var(--card);}
    .prow select,.prow input{height:34px;padding:0 8px;font-size:13px;border-radius:8px;}
    @media(max-width:820px){.prow{grid-template-columns:1fr 1fr 30px;}.prow .hide-sm{display:none;}}
    .prow .x{border:none;background:transparent;color:var(--bad);cursor:pointer;font-size:18px;line-height:1;justify-self:center;}
    .batch-out{max-height:380px;overflow-y:auto;margin-top:12px;border-top:1px dashed var(--border);padding-top:12px;}
    .batch-out::-webkit-scrollbar{width:10px;}
    .batch-out::-webkit-scrollbar-thumb{background:var(--border);border-radius:8px;border:2px solid var(--bg);}
    .batch-actions{display:flex;gap:12px;align-items:center;margin-top:6px;flex-wrap:wrap;}

    /* ===== 关注清单（匿名 localStorage，免登录） ===== */
    .watch{margin-top:28px;}
    .watch-bar{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;margin-top:12px;}
    .watch-bar input{background:var(--card);color:var(--text);border:1px solid var(--line2);border-radius:10px;padding:10px 12px;font-size:14px;width:260px;font-family:ui-monospace,Menlo,monospace;}
    .watch-bar .btn{background:var(--accent);color:#fff;border:none;border-radius:10px;padding:10px 18px;font-size:14px;font-weight:700;cursor:pointer;width:auto;}
    .watch-bar .btn:hover{opacity:.92;}
    .watch-bar .btn.ghost{background:transparent;color:var(--muted);border:1px solid var(--line2);font-weight:600;}
    .watch-table{margin-top:14px;width:100%;border-collapse:collapse;font-size:14.5px;max-width:820px;}
    .watch-table th,.watch-table td{padding:10px 14px;border-bottom:1px solid var(--line2);text-align:left;}
    .watch-table th{color:var(--muted);font-size:12.5px;text-transform:uppercase;letter-spacing:.04em;}
    .watch-table .num{text-align:right;}
    .watch-table .rm{color:var(--bad);background:none;border:none;cursor:pointer;font-weight:600;font-size:13.5px;}

    /* ===== 数据来源横幅 ===== */
    .banner-wrap{max-width:1180px;margin:18px auto 0;padding:0 24px;}
    .banner{display:flex;align-items:flex-start;gap:12px;font-size:13.5px;line-height:1.6;color:#7a4f00;
      background:linear-gradient(180deg,#fffdf3 0%,#fff7e8 100%);border:1px solid #f6d78a;border-left:4px solid var(--warn);border-radius:10px;padding:14px 18px;font-weight:500;}
    .banner .b-source{font-weight:800;color:#92400e;margin-right:4px;}
    .banner .b-disclaim{color:#7a4f00;}
    [data-theme="dark"] .banner{background:#16223a;border-color:var(--line2);color:var(--content);box-shadow:none;}
    [data-theme="dark"] .banner .b-source{color:#a8c0e0;}
    [data-theme="dark"] .banner .b-disclaim{color:var(--muted);}

    /* ===== 页尾（四栏同宽） ===== */
    .site-footer{margin-top:48px;background:var(--card);border-top:1px solid var(--border);}
    .footer-inner{max-width:1180px;margin:0 auto;padding:34px 24px 20px;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:28px;}
    @media(max-width:820px){.footer-inner{grid-template-columns:1fr 1fr;}}
    .site-footer h4{font-size:13px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin:0 0 12px;}
    .site-footer ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px;}
    .site-footer a{color:var(--text);text-decoration:none;font-size:14px;}
    .site-footer a:hover{color:var(--accent);}
    .site-footer .brand-blurb{color:var(--muted);font-size:13px;max-width:280px;margin:10px 0 0;}
    .footer-bottom{max-width:1180px;margin:0 auto;padding:14px 24px;border-top:1px solid var(--border);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:var(--muted);font-size:12.5px;}
    .footer-bottom a{color:var(--muted);}
    @media(max-width:560px){.hero h1{font-size:26px;}.res-hero{flex-direction:column;gap:10px;align-items:flex-start;}.res-hero .h-total-num{margin-left:0;}.res-hero .h-num,.res-hero .h-total-num{font-size:34px;}.total-box .amt{font-size:24px;}.hd-inner{height:auto;padding:12px 16px;flex-wrap:wrap;}.cols{grid-template-columns:1fr;}}
  </style>
  <SeoHead />
</head>
<body>
  <header>
    <div class="hd-inner">
      <a class="brand" href="/"><span class="logo">⬢</span> TariffStack</a>
      <div class="spacer"></div>
      <div class="lang-row">
        <a class="hbtn" href="/hs-codes" data-i18n="hs_enc_btn">HS 编码百科</a>
        <a class="hbtn" href="/guides" data-i18n="guides_btn">关税指南</a>
        <span class="hsep"></span>
        <select id="lang" aria-label="Language">
          {LANGS.map(l => <option value={l.code}>{l.label}</option>)}
        </select>
        <button class="hbtn icon" id="theme-toggle" title="切换主题" aria-label="Toggle dark mode"><span class="tt-ico">🌙</span><span class="tt-txt" data-i18n="theme_dark">深色</span></button>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="wrap" style="max-width:1180px;margin:0 auto;padding:0 24px;">
      <h1 data-i18n="tagline">Import Duty &amp; Landed-Cost Calculator — U.S. + China</h1>
      <p class="sub" data-i18n="hero_sub">Real official tariff stacks for importers, compliance and customs brokers: MFN / 301 / 232 / forced-labour / MPF / HMF — every layer broken down, fully sourced.</p>
      <span class="verified"><span class="dot"></span> <span data-i18n="badge_pre">✓ Rates verified against official customs data on</span> {verifiedDate} <span data-i18n="badge_tz"> (Beijing time)</span></span>
      <div class="alerts" id="alerts-banner" role="status"></div>
    </div>
  </section>

  <div class="banner-wrap">
    <div class="banner" data-i18n-html="banner_header"><span class="b-source">Data aggregated from authoritative open-data feeds</span> · USITC HTS · Federal Register · USTR · CBP CROSS · U.S. Census Bureau · UN Comtrade (cross-verified nightly). <span class="b-disclaim">Before filing any entry, return or refund, always confirm with the destination country's official customs authority or a licensed customs broker.</span></div>
  </div>

  <main>
    <div class="cols">
      <!-- ===== 左：单票计算器（核心） ===== -->
      <div class="col-left">
        <h2 class="sec" data-i18n="section_calc">Quick calculator</h2>
        <section class="card calc">
          <div class="entry">
            <label class="fld" for="hts" data-i18n="calc_hts">HTS code</label>
            <div class="hs-wrap"><input id="hts" class="mono" placeholder="e.g. 6109.10.00" autocomplete="off" value={DEMO_HTS} /><div class="hs-list" id="hsList"></div></div>
          </div>
          <div class="entry">
            <label class="fld" for="product" data-i18n="calc_product">…or pick a product</label>
            <select id="product"><option value="" data-i18n="calc_select">— select —</option>{products.map(p => <option value={p.hts} data-i18n-prod={p.hts}>{p.names.en} — {p.hts}</option>)}</select>
          </div>
          <div class="entry">
            <label class="fld" for="goods" id="goodsLabel" data-i18n="calc_goods">Goods value (USD)</label>
            <input id="goods" type="number" value="1000" min="0" step="1" />
          </div>
          <div class="entry">
            <label class="fld" for="origin" data-i18n="calc_origin">Origin country</label>
            <select id="origin">
              {PINNED_ORIGINS.map(iso2 => {
                const o = ORIGINS.find(x => x.iso2 === iso2);
                if (!o) return null;
                return <option value={o.iso2} selected={o.iso2 === 'CN'} data-i18n-origin={o.iso2}>{originLabel(o.iso2, 'en')}</option>;
              })}
              {POPULAR_ORIGINS.map(iso2 => {
                const o = ORIGINS.find(x => x.iso2 === iso2);
                if (!o) return null;
                return <option value={o.iso2} data-i18n-origin={o.iso2}>{originLabel(o.iso2, 'en')}</option>;
              })}
              {_restOrigins.map(o => <option value={o.iso2} data-i18n-origin={o.iso2} title={US_EMBARGOED.includes(o.iso2) ? 'U.S.-embargoed origin — only the China destination is available' : ''}>{originLabel(o.iso2, 'en')}</option>)}
            </select>
          </div>
          <div class="entry">
            <label class="fld" for="dest" data-i18n="calc_dest">Destination market</label>
            <select id="dest">{destOpts.map(d => <option value={d} selected={d === 'US'} data-i18n-dest={d}>{destLabel(d, 'en')}</option>)}</select>
          </div>
          <div class="entry">
            <label class="fld" for="mode" data-i18n="calc_mode">Transport mode (record only)</label>
            <select id="mode">
              <option value="" data-i18n="mode_none">Unspecified</option>
              <option value="sea" data-i18n="mode_sea">Sea</option>
              <option value="air" data-i18n="mode_air">Air</option>
              <option value="rail" data-i18n="mode_rail">Rail</option>
              <option value="truck" data-i18n="mode_truck">Truck</option>
            </select>
          </div>
          <div class="entry"><button class="btn" id="calc" data-i18n="calc_btn">Calculate</button></div>
        </section>
        <p class="note" data-i18n="calc_mode_note">Duty is assessed on goods value (FOB); transport mode is recorded only and does not change the rate (USITC / HTSUS).</p>

        <section class="card" style="margin-top:18px;">
          <div class="cls-head" data-i18n="classify_title">Don't know the HS code? Describe the product</div>
          <div class="cls-sub" data-i18n="classify_sub">We match your words against the official U.S. HTS schedule (25,903 subheadings) to find the HS code, then compute the real rate for your chosen U.S. or China destination.</div>
          <div class="cls-row">
            <input id="desc" data-i18n-ph="classify_ph" placeholder="e.g. stainless steel water bottle / 不锈钢保温杯" autocomplete="off" />
            <button class="btn" id="cls-btn" data-i18n="classify_btn" style="width:auto">Find HS codes</button>
          </div>
          <div class="matches" id="matches"></div>
        </section>

        <!-- ===== 单票结果（固定 + 限高 + 清空） ===== -->
        <section id="result" class="card" style="margin-top:18px;padding:22px;">
          <h2 class="sec"><span data-i18n="section_result">Calculation result</span> — HTS {worked.hts} · <span data-i18n-dest={worked.dest}>{destLabel(worked.dest, 'en')}</span> · <span data-i18n-origin={worked.origin}>{originLabel(worked.origin, 'en')}</span> · {usd(worked.goods)}</h2>
          <div class="total-box"><span class="lbl" data-i18n="total_row">Total duty + fees</span><span class="amt">{usd(worked.total)}</span><span class="sub">{destLabel(worked.dest,'en')} · {usd(worked.goods)}</span></div>
          <div class="res-hero">
            <div class="hero-row1"><span class="h-label" data-i18n="eff_row">Effective rate</span><span class={`h-num ${effClass(worked.effective)}`}>{pct(worked.effective)}</span></div>
            <div class="hero-row2"><span class="h-total-label" data-i18n="total_row">Total duty + fees</span><span class="h-total-label">:</span><span class="h-total-num">{usd(worked.total)}</span></div>
          </div>
          <table>
            <thead><tr><th data-i18n="col_layer">Layer</th><th class="num" data-i18n="col_rate">Rate</th><th class="num" data-i18n="col_amount">Amount</th></tr></thead>
            <tbody>
              {worked.layers.map(l => (
                <tr><td data-i18n-layer={l.name}>{l.name}</td><td class="num">{l.rate ? pct(l.rate) : '—'}</td><td class="num">{usd(l.amt)}</td></tr>
              ))}
              <tr class="total"><td data-i18n="total_row">Total duty + fees</td><td></td><td class="num">{usd(worked.total)}</td></tr>
            </tbody>
          </table>
          <p class="note">{worked.note}</p>
          <div class="export">
            <button id="exp-json" data-i18n="exp_json">Export JSON</button>
            <button id="exp-csv" data-i18n="exp_csv">Export CSV</button>
            <button id="single-clear" class="clear-btn" data-i18n="single_clear" style="margin-left:auto">Clear result</button>
          </div>
        </section>

        <!-- ===== 批量计算器（自动待算行） ===== -->
        <section class="batch card" id="batch" style="margin-top:24px;">
          <h2 class="sec" data-i18n="section_batch">Batch calculator</h2>
          <p class="note" data-i18n="batch_sub2">Type or pick an HS code — a pending row is added automatically. Each row can set its own origin / market / transport / value; otherwise the shared defaults apply. Then run the batch.</p>
          <div class="binput">
            <div class="grow"><label data-i18n="batch_hs_label">HS code (type or pick — auto-adds a row)</label>
              <div class="hs-wrap"><input id="b-hs" class="mono" autocomplete="off" data-i18n-ph="batch_ph" placeholder="e.g. 6109.10.00" /><div class="hs-list" id="b-hsList"></div></div>
            </div>
            <div><label data-i18n="batch_origin">Origin (shared)</label><select id="batch-origin"></select></div>
            <div><label data-i18n="batch_dest">Market (shared)</label><select id="batch-dest">{destOpts.map(d => <option value={d} selected={d === 'US'} data-i18n-dest={d}>{destLabel(d, 'en')}</option>)}</select></div>
            <div><label data-i18n="batch_mode">Transport (shared)</label><select id="batch-mode"><option value="" data-i18n="mode_none">Unspecified</option><option value="sea" data-i18n="mode_sea">Sea</option><option value="air" data-i18n="mode_air">Air</option><option value="rail" data-i18n="mode_rail">Rail</option><option value="truck" data-i18n="mode_truck">Truck</option></select></div>
            <div><label data-i18n="batch_goods">Goods USD (shared)</label><input id="batch-goods" type="number" value="1000" min="0" step="1" /></div>
          </div>
          <div class="area-head"><span class="t"><span data-i18n="batch_pending_label">Pending rows</span> (<span id="bcount">0</span>)</span><button class="clear-btn" id="clearPending" data-i18n="batch_clear_pending">Clear pending</button></div>
          <div class="pending" id="pending"></div>
          <div class="batch-actions">
            <button class="btn" id="batch-run" data-i18n="batch_btn" style="width:auto">Run batch</button>
            <button class="btn" id="batch-dl" data-i18n="batch_dl" style="display:none;width:auto;background:var(--card);color:var(--text);border:1px solid var(--line2)">Download CSV</button>
            <span class="batch-count" id="batch-count"></span>
          </div>
          <div class="area-head" style="margin-top:16px"><span class="t" data-i18n="batch_result_label">Results</span><button class="clear-btn" id="clearBatchOut" data-i18n="batch_clear_out">Clear results</button></div>
          <div class="batch-out" id="batch-out"></div>
        </section>
      </div>

      <!-- ===== 右：近期变动 + 各国对比 ===== -->
      <div class="col-right">
        <section class="card" id="changes">
          <div class="pad">
            <h2 class="sec" data-i18n="news_title">Live tariff-policy updates</h2>
            <p class="note" data-i18n="news_title_sub">Official sources — the only policy feed on this site (no duplicate scrollers).</p>
            <div class="timeline" id="timeline"></div>
          </div>
        </section>

        <section class="card" style="margin-top:22px;">
          <h2 class="sec" data-i18n="section_byorigin_us">Import duty to the United States — by origin country</h2>
          <div class="sec-sub" data-i18n="sec_sub">HTS 6109.10.00 · $1,000 goods</div>
          <div class="by-origin-scroll">
          <table>
            <thead><tr><th data-i18n="col_origin">Origin</th><th class="num" data-i18n="col_eff">Effective rate</th><th class="num" data-i18n="col_total">Total</th></tr></thead>
            <tbody>
              {compare.map(c => (
                <tr><td data-i18n-origin={c.origin}>{originLabel(c.origin, 'en')}</td><td class={`num ${effClass(c.effective)}`}>{pct(c.effective)}</td><td class="num">{usd(c.total)}</td></tr>
              ))}
            </tbody>
          </table>
          </div>
          <p class="note" data-i18n="note_byorigin_us">U.S. stacking: base MFN + Section 301 (List 4A, China only) + forced-labour 12.5% + MPF/HMF. USMCA partners MX/CA and other FTA countries get MFN waived. Real rate estimates — confirm with CBP or a licensed broker.</p>
        </section>

        <section class="card" style="margin-top:22px;">
          <h2 class="sec" data-i18n="section_byorigin_cn">Import duty to China — by origin country</h2>
          <div class="sec-sub">HS 6109.10 · ¥7,200 goods (≈ $1,000)</div>
          <div class="by-origin-scroll">
          <table>
            <thead><tr><th data-i18n="col_origin">Origin</th><th class="num" data-i18n="col_eff">Effective rate</th><th class="num" data-i18n="col_total">Total</th></tr></thead>
            <tbody>
              {compare_cn.map(c => (
                <tr><td data-i18n-origin={c.origin}>{originLabel(c.origin, 'en')}</td><td class={`num ${effClass(c.effective)}`}>{pct(c.effective)}</td><td class="num">{usd(c.total)}</td></tr>
              ))}
            </tbody>
          </table>
          </div>
          <p class="note" data-i18n="note_byorigin_cn">China applies the official 2026 Import &amp; Export Tariff (State Council Tariff Commission, effective 2026-01-01). Applied duty = provisional rate (暂定税率) when lower, otherwise MFN (最惠国税率). Real published rates, not estimates.</p>
        </section>
      </div>
    </div>

    <!-- ===== 关注清单（匿名 localStorage，免登录免 DB） ===== -->
    <section class="watch card" id="watch" style="margin-top:28px;">
      <h2 class="sec" data-i18n="section_watch">Watchlist &amp; change alerts</h2>
      <p class="note" data-i18n="watch_sub">Save the HS codes you track. We flag official-data updates released after your last visit, and show each watched code’s live effective rate.</p>
      <div class="watch-bar">
        <input id="watch-input" data-i18n-ph="watch_ph" placeholder="e.g. 6109.10.00" autocomplete="off" />
        <button class="btn" id="watch-add" data-i18n="watch_add">Add to watchlist</button>
        <button class="btn ghost" id="watch-clear" data-i18n="watch_clear">Clear all</button>
      </div>
      <div id="watch-list"></div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div class="brand"><span class="logo">⬢</span> TariffStack</div>
        <p class="brand-blurb" data-i18n="footer_tagline">Free import-duty & landed-cost calculator — U.S. + China</p>
      </div>
      <div>
        <h4 data-i18n="footer_product">Product</h4>
        <ul>
          <li><a href="/" data-i18n="footer_calc">Calculator</a></li>
          <li><a href="/hs-codes" data-i18n="hs_enc_btn">HS 编码百科</a></li>
          <li><a href="/guides" data-i18n="guides_btn">关税指南</a></li>
        </ul>
      </div>
      <div>
        <h4 data-i18n="footer_legal">Legal</h4>
        <ul>
          <li><a href="/privacy" data-i18n="footer_privacy">Advertising & Privacy</a></li>
          <li><a href="/terms" data-i18n="footer_terms">Terms of Service & Disclaimer</a></li>
          <li><a href="/about" data-i18n="footer_about">About TariffStack</a></li>
        </ul>
      </div>
      <div>
        <h4 data-i18n="footer_contact">Contact</h4>
        <ul>
          <li><a href="mailto:TariffStack@outlook.com">TariffStack@outlook.com</a></li>
          <li><a href="mailto:zmarkz123zxc@gmail.com" data-i18n="footer_contact_biz">Business inquiries</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 TariffStack · USITC / 中国海关总署</span>
      <span data-i18n="footer_right_tag">权威海关数据 · 仅供参考 · 请以官方公告为准</span>
    </div>
  </footer>

  <CookieConsent />

  <script>
    import sample from '../data/tariff_sample.json';
    import overlay from '../data/policy_overlay.json';
    import { computeStack } from '../lib/calc.ts';
    import { destLabel } from '../lib/destinations.ts';
    import { destOptionsFor } from '../lib/origins.ts';
    import { t, layerName, originLabel, productName, descLabel, LANGS, type Lang } from '../lib/i18n.ts';
    import newsFeed from '../data/news_feed.json';

    const fixed = sample.fixed;
    const sampleRates = sample.rates;
    let FULL = null;
    let cnFull = null;
    const pct = (x) => (x*100).toFixed(2) + '%';
    const usd = (x) => '$' + x.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
    const effClass = (e) => (e > 0.3 ? 'bad' : e > 0.15 ? 'warn' : 'good');

    let LANG = (localStorage.getItem('ts-lang') || 'en');
    if (!LANGS.some(l => l.code === LANG)) LANG = 'en';

    // ---- theme ----
    (function initTheme(){
      try {
        const saved = localStorage.getItem('ts-theme') || 'light';
        if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        const ico = document.querySelector('#theme-toggle .tt-ico');
        const txt = document.querySelector('#theme-toggle .tt-txt');
        if (ico && txt) {
          ico.textContent = saved === 'dark' ? '☀️' : '🌙';
          txt.textContent = t(LANG, saved === 'dark' ? 'theme_light' : 'theme_dark');
        }
      } catch (e) {}
    })();

    const ZH2EN = {
      '手机':'mobile phone','电脑':'computer','笔记本':'laptop computer','平板':'tablet','电视':'television','显示器':'monitor','相机':'camera','耳机':'headphone','音响':'speaker',
      '衣服':'clothing','衬衫':'shirt','裤子':'trousers','袜':'sock','鞋':'footwear shoe','靴':'boot','玩具':'toy','婴儿':'baby','手表':'watch','包':'bag','背包':'backpack','箱':'luggage case','眼镜':'spectacles','帽':'hat cap',
      '钢铁':'steel','钢':'steel','铁':'iron','铝':'aluminum','铜':'copper','不锈钢':'stainless steel','塑料':'plastic','橡胶':'rubber','木':'wood','竹':'bamboo','纸':'paper','棉':'cotton','丝':'silk','麻':'linen','玻璃':'glass','陶瓷':'ceramic','石':'stone','水泥':'cement',
      '家具':'furniture','椅':'chair','桌':'table','床':'bed','沙发':'sofa','灯':'lamp lighting','自行车':'bicycle','汽车':'motor vehicle automobile','摩托车':'motorcycle','轮胎':'tyre tire','电池':'battery','机器':'machine','电机':'electric motor','发动机':'engine','泵':'pump','阀门':'valve','轴承':'bearing','螺丝':'screw','钉':'nail','工具':'tool',
      '食品':'food','米':'rice','糖':'sugar','茶':'tea','咖啡':'coffee','酒':'wine','饮料':'beverage','油':'oil','奶制品':'dairy','肉':'meat','鱼':'fish','药':'pharmaceutical','化妆品':'cosmetic','香水':'perfume','医疗':'medical','口罩':'mask','注射器':'syringe','试剂':'reagent','疫苗':'vaccine',
      '建材':'building material','管':'pipe tube','板':'plate sheet','纺织':'textile','布料':'fabric','地毯':'carpet','窗帘':'curtain','毛巾':'towel','电子':'electronic','电缆':'cable','电线':'wire','插头':'plug','开关':'switch','芯片':'semiconductor chip','电路':'circuit','太阳能':'solar','水壶':'bottle','保温杯':'stainless steel bottle','杯':'cup','碗':'bowl','刀':'knife','锅':'pot pan','叉':'fork','匙':'spoon','瓶':'bottle',
    };
    function expandQuery(q){let out=q;for(const [zh,en] of Object.entries(ZH2EN)) out=out.replace(new RegExp(zh,'g'),' '+en+' ');return out;}

    function classify(descRaw) {
      const isCn = (currentDest === 'CN');
      const ds = isCn ? (cnFull || {}) : (FULL || {});
      if (!ds || !Object.keys(ds).length) return [];
      const enQ = expandQuery(descRaw.toLowerCase()).split(/[^a-z0-9]+/).filter(w => w.length > 2);
      const zhRaw = (descRaw.toLowerCase().match(/[\u4e00-\u9fff]+/g) || []);
      if (!enQ.length && !zhRaw.length) return [];
      const scored = [];
      for (const [hts, rec] of Object.entries(ds)) {
        if (!rec) continue;
        const desc = rec.desc || rec.name || '';
        const text = (hts + ' ' + desc).toLowerCase();
        let score = 0;
        for (const w of enQ) if (text.includes(w)) score++;
        for (const w of zhRaw) if (desc.includes(w)) score++;
        if (score > 0) { const rate = (rec.base !== undefined) ? rec.base : (rec.mfn || 0); scored.push({ hts, score, desc, rate }); }
      }
      scored.sort((a, b) => b.score - a.score || b.rate - a.rate);
      return scored.slice(0, 6);
    }

    function renderMatches() {
      const el = document.getElementById('matches');
      const list = (window.__matches) || [];
      if (!list.length) { el.innerHTML = ''; return; }
      el.innerHTML = list.map(m => `
        <button class="match" data-hts="${m.hts}">
          <span class="m-hts">${m.hts}</span>
          <span class="m-desc">${m.desc}</span>
          <span class="m-rate">${t(LANG,'match_base')} ${pct(m.rate)}</span>
        </button>`).join('');
      el.querySelectorAll('.match').forEach(b => b.addEventListener('click', () => {
        const hts = b.dataset.hts;
        document.getElementById('hts').value = hts;
        const prod = document.getElementById('product');
        if ([...prod.options].some(o => o.value === hts)) prod.value = hts;
        doCalc();
        const card = document.getElementById('result');
        if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }));
    }

    function renderResult(res, targetId) {
      const el = document.getElementById(targetId || 'result');
      if (!res) {
        el.innerHTML = `<h2 class="sec" data-i18n="section_result">${t(LANG,'section_result')}</h2><p class="empty" data-i18n="empty">${t(LANG,'empty')}</p>`;
        return;
      }
      if (res.pending) {
        el.innerHTML = `<h2 class="sec" data-i18n="section_result">${t(LANG,'section_result')}</h2><div class="total-box" style="background:#fff7ed;border-color:#fed7aa"><span class="lbl" data-i18n="cn_pending">${t(LANG,'cn_pending')}</span></div>`;
        return;
      }
      const rows = res.layers.map(l => `<tr><td data-i18n-layer="${l.name}">${layerName(l.name, LANG)}</td><td class="num">${l.rate?pct(l.rate):'—'}</td><td class="num">${usd(l.amt)}</td></tr>`).join('');
      el.innerHTML = `
        <h2 class="sec"><span data-i18n="section_result">${t(LANG,'section_result')}</span> — HTS ${res.hts} · ${destLabel(res.dest, LANG)} · ${originLabel(res.origin, LANG)} · ${usd(res.goods)}</h2>
        <div class="total-box"><span class="lbl" data-i18n="total_row">${t(LANG,'total_row')}</span><span class="amt">${usd(res.total)}</span><span class="sub">${destLabel(res.dest, LANG)} · ${usd(res.goods)}</span></div>
        <div class="res-hero">
          <div class="hero-row1"><span class="h-label" data-i18n="eff_row">${t(LANG,'eff_row')}</span><span class="h-num ${effClass(res.effective)}">${pct(res.effective)}</span></div>
          <div class="hero-row2"><span class="h-total-label" data-i18n="total_row">${t(LANG,'total_row')}</span><span class="h-total-label">:</span><span class="h-total-num">${usd(res.total)}</span></div>
        </div>
        <table><thead><tr><th data-i18n="col_layer">${t(LANG,'col_layer')}</th><th class="num" data-i18n="col_rate">${t(LANG,'col_rate')}</th><th class="num" data-i18n="col_amount">${t(LANG,'col_amount')}</th></tr></thead><tbody>${rows}
          <tr class="total"><td data-i18n="total_row">${t(LANG,'total_row')}</td><td></td><td class="num">${usd(res.total)}</td></tr>
        </tbody></table>
        ${!res.indicative && res.dest !== 'US' ? `<p class="note" data-i18n="dest_real">${t(LANG,'dest_real')}</p>` : ''}
        <p class="note">${res.note}</p>
        <div class="export"><button id="exp-json" data-i18n="exp_json">${t(LANG,'exp_json')}</button><button id="exp-csv" data-i18n="exp_csv">${t(LANG,'exp_csv')}</button><button id="single-clear" class="clear-btn" data-i18n="single_clear" style="margin-left:auto">${t(LANG,'single_clear')}</button></div>`;
      bindExport();
    }

    let currentDest = 'US';
    function doCalc() {
      const hts = (document.getElementById('hts').value || document.getElementById('product').value || '').trim();
      const origin = document.getElementById('origin').value;
      const goods = parseFloat(document.getElementById('goods').value) || 0;
      const dest = document.getElementById('dest').value;
      let res = null;
      if (dest === 'CN') res = computeStack(dest, hts, origin, goods, sampleRates, fixed, overlay, cnFull);
      else { const rates = FULL || sampleRates; res = rates[hts] ? computeStack(dest, hts, origin, goods, rates, fixed, overlay) : null; }
      window.__last = res; currentDest = dest; renderResult(res);
    }

    function updateFieldHints() {
      const dest = document.getElementById('dest').value;
      const htsInput = document.getElementById('hts');
      if (htsInput) htsInput.placeholder = dest === 'CN' ? 'e.g. 6109.10' : 'e.g. 6109.10.00';
      const goodsLabel = document.getElementById('goodsLabel');
      if (goodsLabel) goodsLabel.textContent = t(LANG, dest === 'CN' ? 'goods_label_cn' : 'calc_goods');
    }

    function applyLang(lang) {
      LANG = lang; localStorage.setItem('ts-lang', lang); document.documentElement.lang = lang;
      document.getElementById('lang').value = lang;
      document.querySelectorAll('[data-i18n]').forEach(e => { let s = t(lang, e.getAttribute('data-i18n')); if (s) e.textContent = s; });
      document.querySelectorAll('[data-i18n-html]').forEach(e => { e.innerHTML = t(lang, e.getAttribute('data-i18n-html')); });
      document.querySelectorAll('[data-i18n-ph]').forEach(e => { const k = e.getAttribute('data-i18n-ph'); if (k) e.placeholder = t(lang, k); });
      document.querySelectorAll('[data-i18n-layer]').forEach(e => { e.textContent = layerName(e.getAttribute('data-i18n-layer'), lang); });
      document.querySelectorAll('[data-i18n-origin]').forEach(e => { e.textContent = originLabel(e.getAttribute('data-i18n-origin'), lang); });
      document.querySelectorAll('[data-i18n-prod]').forEach(e => { const c = e.getAttribute('data-i18n-prod'); e.textContent = productName(c, lang) + ' — ' + c; });
      document.querySelectorAll('[data-i18n-dest]').forEach(e => { e.textContent = destLabel(e.getAttribute('data-i18n-dest'), lang); });
      updateFieldHints();
      if (window.__last) renderResult(window.__last);
      if (window.__matches && window.__matches.length) renderMatches();
      renderBatch(); renderPending(); renderWatch(); renderTimeline(); renderAlerts();
    }

    function renderDestOptions(origin) {
      const sel = document.getElementById('dest');
      const opts = destOptionsFor(origin);
      sel.innerHTML = opts.map(d => `<option value="${d}" data-i18n-dest="${d}">${destLabel(d, LANG)}</option>`).join('');
      sel.value = opts.includes(sel.value) ? sel.value : (opts[0] || 'CN');
      updateFieldHints();
    }

    // ===== HS 自动补全（可输入也可点选；真实全量数据） =====
    function hsSuggest(q) {
      const isCn = (document.getElementById('dest').value === 'CN');
      const ds = isCn ? (cnFull || {}) : (FULL || {});
      if (!ds || !Object.keys(ds).length) return [];
      const nq = (q||'').trim().toLowerCase().replace(/[\s.]/g,'');
      const out = [];
      for (const [code, rec] of Object.entries(ds)) {
        const desc = (rec && (rec.desc || rec.name)) || '';
        if (!nq || code.replace(/\./g,'').includes(nq) || (nq.length > 1 && desc.toLowerCase().includes(nq))) {
          out.push({ code, desc });
          if (out.length >= 12) break;
        }
      }
      return out;
    }
    function setupHs(inputId, listId, onPick) {
      const inp = document.getElementById(inputId), list = document.getElementById(listId);
      if (!inp || !list) return;
      function render(q) {
        const items = hsSuggest(q);
        list.innerHTML = items.length ? items.map(it => `<div class="opt" data-c="${it.code}"><span class="c">${it.code}</span><span class="d">${it.desc}</span></div>`).join('') : '<div class="opt none" data-i18n="classify_none">'+t(LANG,'classify_none')+'</div>';
        list.classList.add('show');
        list.querySelectorAll('.opt[data-c]').forEach(o => {
          o.addEventListener('mousedown', e => e.preventDefault());
          o.onclick = () => { inp.value = o.dataset.c; list.classList.remove('show'); if (onPick) onPick(o.dataset.c); };
        });
      }
      inp.addEventListener('focus', () => render(inp.value));
      inp.addEventListener('input', () => render(inp.value));
      inp.addEventListener('blur', () => setTimeout(() => list.classList.remove('show'), 150));
      inp.addEventListener('keydown', e => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const first = list.querySelector('.opt[data-c]');
          if (first) { inp.value = first.dataset.c; list.classList.remove('show'); if (onPick) onPick(first.dataset.c); }
          else if (inp.value.trim()) { list.classList.remove('show'); if (onPick) onPick(inp.value.trim()); }
        }
      });
    }
    setupHs('hts','hsList', (c) => doCalc());
    setupHs('b-hs','b-hsList', (c) => addRow());

    // ===== events =====
    document.getElementById('origin').addEventListener('change', e => { renderDestOptions(e.target.value); doCalc(); });
    document.getElementById('calc').addEventListener('click', () => { doCalc(); document.getElementById('result').scrollIntoView({ behavior:'smooth', block:'start' }); });
    document.getElementById('product').addEventListener('change', e => { document.getElementById('hts').value = e.target.value; });
    document.getElementById('hts').addEventListener('change', doCalc);
    document.getElementById('dest').addEventListener('change', () => { doCalc(); updateFieldHints(); });
    document.getElementById('lang').addEventListener('change', e => applyLang(e.target.value));
    document.getElementById('theme-toggle').addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      if (next === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); else document.documentElement.removeAttribute('data-theme');
      try { localStorage.setItem('ts-theme', next); } catch (e) {}
      const ico = document.querySelector('#theme-toggle .tt-ico'); const txt = document.querySelector('#theme-toggle .tt-txt');
      if (ico && txt) { ico.textContent = next === 'dark' ? '☀️' : '🌙'; txt.textContent = t(LANG, next === 'dark' ? 'theme_light' : 'theme_dark'); }
    });
    document.getElementById('cls-btn').addEventListener('click', () => {
      window.__matches = classify(document.getElementById('desc').value); renderMatches();
      if (!window.__matches.length) document.getElementById('matches').innerHTML = `<p class="empty" data-i18n="classify_none">${t(LANG,'classify_none')}</p>`;
    });
    document.getElementById('desc').addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('cls-btn').click(); });

    function download(name, text, type) {
      const b = new Blob([text], { type }); const u = URL.createObjectURL(b);
      const a = document.createElement('a'); a.href = u; a.download = name; a.click(); URL.revokeObjectURL(u);
    }
    function bindExport() {
      const ej = document.getElementById('exp-json'); if (ej) ej.onclick = () => {
        if (!window.__last) return;
        const payload = { meta:{ tool:'TariffStack', generated_at:new Date().toISOString(), data_as_of:overlay.as_of, data_last_checked:overlay.last_checked, destination:window.__last.dest },
          result: window.__last };
        download('tariffstack-result.json', JSON.stringify(payload, null, 2), 'application/json');
      };
      const ec = document.getElementById('exp-csv'); if (ec) ec.onclick = () => {
        const r = window.__last; if (!r) return;
        const head = `# TariffStack audit export\n# data_as_of,${overlay.as_of}\n# last_checked,${overlay.last_checked}\n# generated_at,${new Date().toISOString()}\nlayer,rate,amount\n`;
        const body = r.layers.map(l => `"${layerName(l.name, LANG)}",${l.rate},${l.amt.toFixed(2)}`).join('\n');
        download('tariffstack-result.csv', head + body, 'text/csv');
      };
      const sc = document.getElementById('single-clear'); if (sc) sc.onclick = () => {
        document.getElementById('result').innerHTML = `<h2 class="sec" data-i18n="section_result">${t(LANG,'section_result')}</h2><p class="empty" data-i18n="empty">${t(LANG,'empty')}</p>`;
      };
    }
    bindExport();

    // ===== BATCH（自动待算行） =====
    const batchOriginSel = document.getElementById('batch-origin');
    if (batchOriginSel) batchOriginSel.innerHTML = document.getElementById('origin').innerHTML;
    const pending = [];
    function modesOptions(sel) {
      const modes = [['','mode_none'],['sea','mode_sea'],['air','mode_air'],['rail','mode_rail'],['truck','mode_truck']];
      return modes.map(([v,k]) => `<option value="${v}" ${v===sel?'selected':''}>${t(LANG,k)}</option>`).join('');
    }
    function addRow() {
      const hs = document.getElementById('b-hs').value.trim();
      if (!hs) return;
      pending.push({ hs, origin: document.getElementById('batch-origin').value, dest: document.getElementById('batch-dest').value, mode: document.getElementById('batch-mode').value, goods: document.getElementById('batch-goods').value || '1000' });
      document.getElementById('b-hs').value = '';
      renderPending();
    }
    function renderPending() {
      const el = document.getElementById('pending'); const cnt = document.getElementById('bcount');
      if (!el) return;
      cnt.textContent = pending.length;
      if (!pending.length) { el.innerHTML = `<div class="empty" data-i18n="watch_empty">${t(LANG,'batch_empty_pending')}</div>`; return; }
      const originOpts = document.getElementById('origin').innerHTML;
      const destOpts = document.getElementById('dest').innerHTML;
      el.innerHTML = pending.map((r,i) => `
        <div class="prow">
          <span class="mono">${r.hs}</span>
          <select class="p-origin hide-sm" data-i="${i}">${originOpts.replace('value="'+r.origin+'"','value="'+r.origin+'" selected')}</select>
          <select class="p-dest hide-sm" data-i="${i}">${destOpts.replace('value="'+r.dest+'"','value="'+r.dest+'" selected')}</select>
          <select class="p-mode hide-sm" data-i="${i}">${modesOptions(r.mode)}</select>
          <input class="p-goods mono" data-i="${i}" value="${r.goods}" />
          <button class="x" data-i="${i}">×</button>
        </div>`).join('');
      el.querySelectorAll('.p-origin').forEach(s => s.onchange = e => { pending[+s.dataset.i].origin = e.target.value; });
      el.querySelectorAll('.p-dest').forEach(s => s.onchange = e => { pending[+s.dataset.i].dest = e.target.value; });
      el.querySelectorAll('.p-mode').forEach(s => s.onchange = e => { pending[+s.dataset.i].mode = e.target.value; });
      el.querySelectorAll('.p-goods').forEach(s => s.oninput = e => { pending[+s.dataset.i].goods = e.target.value; });
      el.querySelectorAll('.x').forEach(b => b.onclick = () => { pending.splice(+b.dataset.i, 1); renderPending(); });
    }
    function batchCompute(hts, origin, dest, goods) {
      if (dest === 'CN') return computeStack(dest, hts, origin, goods, sampleRates, fixed, overlay, cnFull);
      const rates = FULL || sampleRates;
      return rates[hts] ? computeStack(dest, hts, origin, goods, rates, fixed, overlay) : null;
    }
    function doBatch() {
      if (!pending.length) { document.getElementById('batch-out').innerHTML = `<div class="empty" data-i18n="batch_empty">${t(LANG,'batch_empty')}</div>`; return; }
      const rows = pending.map(r => ({ ...r, res: batchCompute(r.hs, (r.origin||'CN').toUpperCase(), (r.dest||'US').toUpperCase(), parseFloat(r.goods) || 0) }));
      window.__batch = rows; renderBatch();
    }
    function renderBatch() {
      const out = document.getElementById('batch-out'); const dl = document.getElementById('batch-dl'); const cnt = document.getElementById('batch-count');
      if (!out) return;
      const rows = window.__batch || [];
      if (!rows.length) { out.innerHTML = ''; if (dl) dl.style.display = 'none'; if (cnt) cnt.textContent = ''; return; }
      const body = rows.map(r => {
        if (!r.res) return `<tr><td>${r.hs}</td><td>${originLabel(r.origin, LANG)}</td><td>${destLabel(r.dest, LANG)}</td><td class="num">${usd(r.goods)}</td><td class="num">—</td><td class="num">—</td></tr>`;
        return `<tr><td class="mono">${r.hs}</td><td>${originLabel(r.origin, LANG)}</td><td>${destLabel(r.dest, LANG)}</td><td class="num">${usd(r.goods)}</td><td class="num ${effClass(r.res.effective)}">${pct(r.res.effective)}</td><td class="num">${usd(r.res.total)}</td></tr>`;
      }).join('');
      out.innerHTML = `<table><thead><tr><th>${t(LANG,'batch_col_hts')}</th><th>${t(LANG,'batch_col_origin')}</th><th>${t(LANG,'batch_col_dest')}</th><th class="num">${t(LANG,'batch_col_goods')}</th><th class="num">${t(LANG,'batch_col_eff')}</th><th class="num">${t(LANG,'batch_col_total')}</th></tr></thead><tbody>${body}</tbody></table>`;
      if (dl) dl.style.display = '';
      if (cnt) cnt.textContent = t(LANG,'batch_count').replace('{n}', String(rows.length));
    }
    function downloadBatchCSV() {
      const rows = window.__batch || []; if (!rows.length) return;
      const esc = s => `"${String(s).replace(/"/g,'""')}"`;
      const head = `hts,origin,dest,mode,goods,effective_rate,total_duty\n`;
      const body = rows.map(r => `${esc(r.hs)},${esc(r.origin)},${esc(r.dest)},${esc(r.mode)},${r.goods},${(r.res?pct(r.res.effective):'—')},${r.res?r.res.total.toFixed(2):''}`).join('\n');
      download('tariffstack-batch.csv', head + body, 'text/csv');
    }
    document.getElementById('batch-run').addEventListener('click', doBatch);
    document.getElementById('batch-dl').addEventListener('click', downloadBatchCSV);
    document.getElementById('clearPending').addEventListener('click', () => { pending.length = 0; renderPending(); document.getElementById('batch-dl').style.display = 'none'; });
    document.getElementById('clearBatchOut').addEventListener('click', () => { window.__batch = []; renderBatch(); document.getElementById('batch-dl').style.display = 'none'; });

    // ===== WATCHLIST（匿名 localStorage） =====
    const WKEY = 'ts-watch';
    function loadWatch() { try { return JSON.parse(localStorage.getItem(WKEY) || '[]'); } catch (e) { return []; } }
    function saveWatch(list) { try { localStorage.setItem(WKEY, JSON.stringify(list)); } catch (e) {} }
    function renderWatch() {
      const el = document.getElementById('watch-list'); if (!el) return;
      const list = loadWatch();
      if (!list.length) { el.innerHTML = `<p class="empty" data-i18n="watch_empty">${t(LANG,'watch_empty')}</p>`; return; }
      const body = list.map((w, i) => {
        const res = batchCompute(w.hts, (w.origin || 'CN').toUpperCase(), (w.dest || 'US').toUpperCase(), 1000);
        const rate = res ? pct(res.effective) : '—';
        const duty = res ? usd(res.total) : '—';
        return `<tr><td class="mono">${w.hts}</td><td>${originLabel(w.origin || 'CN', LANG)}</td><td>${destLabel(w.dest || 'US', LANG)}</td><td class="num ${res?effClass(res.effective):''}">${rate}</td><td class="num">${duty}</td><td class="num"><button class="rm" data-rm="${i}" data-i18n="watch_remove">${t(LANG,'watch_remove')}</button></td></tr>`;
      }).join('');
      el.innerHTML = `<table class="watch-table"><thead><tr><th>${t(LANG,'watch_col_hts')}</th><th>${t(LANG,'batch_col_origin')}</th><th>${t(LANG,'batch_col_dest')}</th><th class="num">${t(LANG,'watch_col_rate')}</th><th class="num">${t(LANG,'watch_col_total')}</th><th></th></tr></thead><tbody>${body}</tbody></table>`;
      el.querySelectorAll('[data-rm]').forEach(b => b.onclick = () => { const idx = parseInt(b.getAttribute('data-rm'),10); const l = loadWatch(); l.splice(idx,1); saveWatch(l); renderWatch(); });
    }
    function addWatch() {
      const inp = document.getElementById('watch-input'); const hts = (inp && inp.value || '').trim(); if (!hts) return;
      const list = loadWatch(); if (!list.some(w => w.hts === hts)) list.push({ hts, origin: document.getElementById('origin').value, dest: document.getElementById('dest').value });
      saveWatch(list); if (inp) inp.value = ''; renderWatch();
    }
    document.getElementById('watch-add').addEventListener('click', addWatch);
    document.getElementById('watch-clear').addEventListener('click', () => { saveWatch([]); renderWatch(); });
    const watchInp = document.getElementById('watch-input');
    if (watchInp) watchInp.addEventListener('keydown', e => { if (e.key === 'Enter') addWatch(); });

    // ===== 近期变动时间线（唯一政策呈现） =====
    function renderTimeline() {
      const el = document.getElementById('timeline'); if (!el || !newsFeed || !newsFeed.items) return;
      el.innerHTML = newsFeed.items.map(n => {
        const txt = t(LANG, n.key) || n.key;
        const tag = destLabel(n.tag || 'US', LANG);
        const date = (n.date || '').slice(0, 10);
        return `<div class="tl"><div class="date">${date}</div><div class="body"><span class="tag">${tag}</span>${txt}</div></div>`;
      }).join('');
    }

    // ===== 变动预警横幅 =====
    function renderAlerts() {
      const el = document.getElementById('alerts-banner'); if (!el) return;
      const last = (overlay.last_checked || '').slice(0, 10);
      let seen = ''; try { seen = localStorage.getItem('ts_lastvisit') || ''; } catch (e) {}
      if (last && seen && last > seen) { el.className = 'alerts'; el.innerHTML = '⚠ ' + t(LANG, 'alerts_new').replace('{date}', last); }
      else { el.className = 'alerts'; el.innerHTML = '✓ ' + t(LANG, 'alerts_none'); }
      try { if (last) localStorage.setItem('ts_lastvisit', last); } catch (e) {}
    }

    // ===== 加载全量数据 + 初始化 =====
    fetch('/data/tariff_full.json').then(r => r.json()).then(j => { FULL = j; doCalc(); renderPending(); renderWatch(); })
      .catch(() => { FULL = null; doCalc(); });
    fetch('/data/tariff_full_cn.json').then(r => r.json()).then(j => { cnFull = (j && j.by_hs8) ? j.by_hs8 : j; doCalc(); renderPending(); renderWatch(); })
      .catch(() => { cnFull = null; doCalc(); });
    renderTimeline();
    applyLang(LANG);
    renderAlerts();

    // ?hts=CODE 从百科页跳转预填
    try {
      const hp = new URLSearchParams(location.search).get('hts');
      if (hp) { document.getElementById('hts').value = hp; doCalc(); }
    } catch (e) {}
  </script>
</body>
</html>
