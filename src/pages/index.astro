---
import SeoHead from '../components/SeoHead.astro';
import sample from '../data/tariff_sample.json';
import overlay from '../data/policy_overlay.json';
import full from '../data/tariff_full.json';
// CN full tariff is fetched at runtime (kept out of the bundle)
import { computeStack, type Rate } from '../lib/calc.ts';
import { destLabel } from '../lib/destinations.ts';
import { ORIGINS, destOptionsFor, US_EMBARGOED } from '../lib/origins.ts';
import { t, layerName, originLabel, LANGS } from '../lib/i18n.ts';
import newsFeed from '../data/news_feed.json';
import CookieConsent from '../components/CookieConsent.astro';

const rates = sample.rates;
const fixed = sample.fixed;

const PINNED_ORIGINS = ['US', 'CN'];
const POPULAR_ORIGINS = ['VN','MX','DE','FR','IT','ES','NL','IE','PL','SE','BE','AT','PT','FI','DK','GR','GB','JP','KR','IN','TH','TW','MY','ID','PH','SG','BD','PK','BR','AR','AU','NZ','CH','TR','ZA','SA','AE','IL'];
const _popularSet = new Set(POPULAR_ORIGINS);
const _restOrigins = ORIGINS.filter(o => !_popularSet.has(o.iso2) && !PINNED_ORIGINS.includes(o.iso2));
const destOpts = destOptionsFor('CN');

const DEMO_HTS = '6109.10.00';
const fullRates = (full && typeof full === 'object') ? (full as Record<string, Rate>) : {};
const demoRates = fullRates[DEMO_HTS] ? fullRates : (rates as Record<string, Rate>);

const newsItems = (newsFeed && (newsFeed as { items?: any[] }).items) ? (newsFeed as { items: any[] }).items : [];
const DEFAULT_DEST = 'US';
const worked = computeStack(DEFAULT_DEST, DEMO_HTS, 'CN', 1000, demoRates, fixed, overlay)!;

const verifiedDate = String(overlay.last_checked || overlay.as_of || '').slice(0, 10);
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "TariffStack — Import Duty & Landed-Cost Calculator",
  "applicationCategory": "FinanceApplication",
  "applicationSubCategory": "CustomsDutyCalculator",
  "operatingSystem": "Any",
  "inLanguage": ["en", "zh", "zh-TW", "ja", "ko", "es", "fr", "pt", "de", "it"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "description": "Free import duty and landed-cost calculator with multi-language UI and product-to-HS classification. U.S. full official stacked tariff (USITC HTS, subheading-level) is live; China destination official 2026 tariff schedule (State Council Tariff Commission, effective 2026-01-01) is live with REAL rates (最惠国/MFN + 暂定/provisional).",
  "dateModified": verifiedDate
});

const pct = (x: number) => (x * 100).toFixed(2) + '%';
const usd = (x: number) => '$' + x.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const effClass = (e: number) => (e > 0.3 ? 'bad' : e > 0.15 ? 'warn' : 'good');
const LAYER_COLOR: Record<string,string> = {'mfn':'mfn','s301':'s301','s232':'s232','forced':'forced','forced_labor':'forced','mpf':'mpf','hmf':'hmf'};
const layerColorVar = (n: string) => 'var(--' + (LAYER_COLOR[n] || 'accent') + ')';
const workedPos = worked.layers.filter(l => l.rate > 0);
const workedSum = workedPos.reduce((s,l)=>s+l.rate,0) || 1;
const workedBar = workedPos.map(l => `<i style="width:${(l.rate/workedSum*100).toFixed(1)}%;background:${layerColorVar(l.name)}"></i>`).join('');
const workedLeg = workedPos.map(l => `<span><i class="sw" style="background:${layerColorVar(l.name)}"></i>${layerName(l.name,'en')} ${pct(l.rate)}</span>`).join('');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>TariffStack — Import Duty &amp; Landed-Cost Calculator</title>
  <meta name="description" content={`Free import duty and landed-cost calculator with multi-language UI and product-to-HS classification. U.S. full official stacked tariff (USITC HTS, subheading-level) is live; China destination official 2026 tariff schedule (State Council Tariff Commission, effective 2026-01-01) is live with REAL rates. Verified ${verifiedDate} (Beijing time).`} />
  <script type="application/ld+json" set:html={jsonLd}></script>
  <SeoHead />
  <style is:global>
    :root{
      --bg:#f4f6fb; --header-bg:#ffffff; --card:#ffffff; --text:#1a2233; --muted:#5b6678;
      --accent:#2f6df0; --accent-soft:#e8f0ff; --border:#e2e8f2; --good:#10b981; --warn:#f59e0b; --bad:#ef4444;
      --mfn:#3b82f6; --s301:#f59e0b; --s232:#8b5cf6; --forced:#64748b; --mpf:#06b6d4; --hmf:#10b981;
      --radius:14px; --shadow:0 1px 2px rgba(20,30,60,.06),0 8px 24px rgba(20,30,60,.07);
      --shadow-hi:0 2px 4px rgba(20,30,60,.08),0 14px 40px rgba(20,30,60,.12);
      --maxw:1180px;
    }
    html[data-theme="dark"]{
      --bg:#0e1320; --header-bg:#131a2b; --card:#161e30; --text:#e6ebf5; --muted:#9aa6bd;
      --accent:#8aa7d8; --accent-soft:#1a2740; --border:#243049;
      --mfn:#6b9bff; --s301:#d9a85a; --s232:#a892d8; --forced:#8b97ad; --mpf:#6fc7d8; --hmf:#6fbfa0;
      --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.35);
      --shadow-hi:0 2px 4px rgba(0,0,0,.35),0 14px 40px rgba(0,0,0,.5);
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 -apple-system,"Segoe UI",Roboto,"PingFang SC","Microsoft YaHei",Arial,sans-serif;-webkit-font-smoothing:antialiased}
    .mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-variant-numeric:tabular-nums}
    .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}

    /* ===== 页头：整条白色区域底边带弧 ===== */
    .site-header{background:var(--header-bg);border-radius:0 0 30px 30px;box-shadow:var(--shadow);position:sticky;top:0;z-index:30}
    .site-header .wrap{display:flex;align-items:center;gap:14px;height:64px}
    .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px;letter-spacing:.2px;text-decoration:none;color:var(--text)}
    .brand .logo{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,var(--accent),#7aa7ff);display:grid;place-items:center;color:#fff;font-size:15px;box-shadow:0 4px 12px rgba(47,109,240,.35)}
    .spacer{flex:1}
    .lang-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;flex-shrink:0}
    .hbtn{display:inline-flex;align-items:center;gap:7px;height:40px;padding:0 16px;border-radius:999px;border:1px solid var(--border);background:var(--card);color:var(--text);font-size:14px;cursor:pointer;transition:.15s;white-space:nowrap;text-decoration:none}
    .hbtn:hover{box-shadow:var(--shadow);transform:translateY(-1px)}
    .hbtn.accent{background:var(--accent);border-color:var(--accent);color:#fff}
    .hsep{width:1px;height:24px;background:var(--border);margin:0 2px}
    select#lang{height:40px;border-radius:999px;border:1px solid var(--border);background:var(--card);color:var(--text);padding:0 14px;font-size:14px;cursor:pointer;width:auto}
    @media(max-width:900px){.site-header .wrap{gap:8px;padding:0 16px}.lang-row{gap:6px}}

    /* ===== Hero ===== */
    .hero{padding:46px 0 14px}
    .hero h1{font-size:34px;margin:0 0 10px;line-height:1.15}
    .hero .sub{color:var(--muted);max-width:640px;margin:0 0 18px}
    .verified{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);background:var(--card);border:1px solid var(--border);border-radius:999px;padding:6px 14px;box-shadow:var(--shadow)}
    .verified .dot{width:8px;height:8px;border-radius:50%;background:var(--good);box-shadow:0 0 0 4px color-mix(in srgb,var(--good) 22%,transparent)}

    /* ===== 卡片 ===== */
    .card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);position:relative;overflow:hidden}
    .card::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--accent),transparent)}
    .card .pad{padding:22px}
    .card h2{margin:0 0 4px;font-size:18px}
    .card .hint{color:var(--muted);font-size:13px;margin:0 0 16px}

    .grid2{display:grid;grid-template-columns:1.15fr .85fr;gap:22px;margin-top:26px}
    @media(max-width:900px){.grid2{grid-template-columns:1fr}}

    label{display:block;font-size:13px;color:var(--muted);margin:0 0 6px}
    .row{display:grid;gap:14px;margin-bottom:14px}
    .row.c3{grid-template-columns:1fr 1fr 1fr}
    .row.c2{grid-template-columns:1fr 1fr}
    @media(max-width:620px){.row.c3,.row.c2{grid-template-columns:1fr}}
    input,select{width:100%;height:42px;border-radius:10px;border:1px solid var(--border);background:var(--bg);color:var(--text);padding:0 12px;font-size:14px}
    input:focus,select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
    .btn{height:44px;border-radius:10px;border:1px solid var(--accent);background:var(--accent);color:#fff;font-size:15px;font-weight:600;cursor:pointer;padding:0 20px;transition:.15s}
    .btn:hover{transform:translateY(-1px);box-shadow:var(--shadow)}
    .btn.ghost{background:var(--card);color:var(--text);border-color:var(--border)}
    .note{font-size:13px;color:var(--muted);margin-top:10px;line-height:1.6}

    /* HS 自动补全下拉（可输入也可点选） */
    .hs-wrap{position:relative}
    .hs-list{position:absolute;top:44px;left:0;right:0;background:var(--card);border:1px solid var(--border);border-radius:10px;box-shadow:var(--shadow-hi);max-height:248px;overflow-y:auto;z-index:25;display:none}
    .hs-list.show{display:block}
    .hs-list .opt{display:flex;gap:10px;padding:9px 12px;cursor:pointer;font-size:13px;align-items:baseline}
    .hs-list .opt:hover,.hs-list .opt.active{background:var(--accent-soft)}
    .hs-list .opt .c{font-family:ui-monospace,Menlo,monospace;color:var(--accent);font-weight:700;min-width:82px;flex:none}
    .hs-list .opt .d{color:var(--muted);display:flex;flex-direction:column;gap:2px}
    .hs-list .opt.none{color:var(--muted);cursor:default}

    /* ===== 结果区：限高 + 滑轮 ===== */
    .result{max-height:360px;overflow-y:auto;margin-top:16px;border-top:1px dashed var(--border);padding-top:14px}
    .result::-webkit-scrollbar{width:10px}
    .result::-webkit-scrollbar-thumb{background:var(--border);border-radius:8px;border:2px solid var(--bg)}
    .result::-webkit-scrollbar-track{background:transparent}
    .empty{color:var(--muted);font-size:13px;padding:18px 0;text-align:center}
    table{width:100%;border-collapse:collapse;font-size:13.5px}
    th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--border)}
    th{color:var(--muted);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.4px}
    td.num{text-align:right;font-family:ui-monospace,Menlo,monospace}
    .sw{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:7px;vertical-align:middle}

    /* 层占比条 */
    .bar{display:flex;height:14px;border-radius:7px;overflow:hidden;margin:10px 0 4px;background:var(--bg)}
    .bar i{height:100%}
    .legend{display:flex;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--muted);margin-top:6px}
    .legend span{display:inline-flex;align-items:center}

    /* 关税合计醒目标识 */
    .total-box{display:flex;align-items:baseline;gap:12px;padding:14px 16px;border-radius:12px;background:var(--accent-soft);border:1px solid color-mix(in srgb,var(--accent) 35%,var(--border));margin-bottom:14px}
    .total-box .lbl{font-size:13px;color:var(--muted);font-weight:600}
    .total-box .amt{font-family:ui-monospace,Menlo,monospace;font-size:28px;font-weight:800;color:var(--accent);letter-spacing:-.5px}
    .total-box .sub{font-size:12px;color:var(--muted);margin-left:auto}

    /* ===== 批量：输入行 + 自动待算区 ===== */
    .binput{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr .9fr auto;gap:10px;align-items:end}
    @media(max-width:820px){.binput{grid-template-columns:1fr 1fr;}}
    .binput .grow{grid-column:1/-1}
    .pending{margin:14px 0 6px;display:flex;flex-direction:column;gap:8px;max-height:240px;overflow-y:auto}
    .pending::-webkit-scrollbar{width:10px}
    .pending::-webkit-scrollbar-thumb{background:var(--border);border-radius:8px;border:2px solid var(--bg)}
    .area-head{display:flex;align-items:center;justify-content:space-between;margin:2px 0 8px}
    .area-head .t{font-size:13px;color:var(--muted)}
    .clear-btn{height:30px;padding:0 12px;border-radius:8px;border:1px solid var(--border);background:var(--card);color:var(--muted);font-size:12.5px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
    .clear-btn:hover{color:var(--bad);border-color:var(--bad)}
    .prow{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr .9fr 32px;gap:10px;align-items:center;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:8px 10px;font-size:13px}
    @media(max-width:820px){.prow{grid-template-columns:1fr 1fr 32px}.prow .hide-sm{display:none}}
    .prow .x{border:none;background:transparent;color:var(--bad);cursor:pointer;font-size:18px;line-height:1}
    .batch-out{max-height:380px;overflow-y:auto;margin-top:14px;border-top:1px dashed var(--border);padding-top:12px}
    .batch-out::-webkit-scrollbar{width:10px}
    .batch-out::-webkit-scrollbar-thumb{background:var(--border);border-radius:8px;border:2px solid var(--bg)}
    .batch-actions{display:flex;gap:12px;align-items:center;margin-top:6px;flex-wrap:wrap}

    /* ===== 近期关税变动 时间线（唯一呈现，删滚动条） ===== */
    .timeline{margin-top:8px}
    .tl{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid var(--border)}
    .tl:last-child{border-bottom:none}
    .tl .date{font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--muted);min-width:74px}
    .tl .body{font-size:14px}
    .tl .tag{display:inline-block;font-size:11px;padding:2px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent);margin-right:8px}

    /* ===== 导出 ===== */
    .export{margin-top:16px;display:flex;gap:12px;flex-wrap:wrap}
    .export button{background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:9px;padding:10px 16px;font-size:14px;font-weight:600;cursor:pointer}
    .export button:hover{border-color:var(--accent);color:var(--accent)}

    /* ===== 页尾：与正文同宽、左右安全边距 ===== */
    .site-footer{margin-top:54px;background:var(--header-bg);border-top:1px solid var(--border)}
    .footer-inner{max-width:var(--maxw);margin:0 auto;padding:40px 24px 22px;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:28px}
    @media(max-width:820px){.footer-inner{grid-template-columns:1fr 1fr}}
    .site-footer h4{font-size:13px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin:0 0 12px}
    .site-footer ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
    .site-footer a{color:var(--text);text-decoration:none;font-size:14px}
    .site-footer a:hover{color:var(--accent)}
    .site-footer .brand-blurb{color:var(--muted);font-size:13px;max-width:280px;margin:10px 0 0}
    .footer-bottom{max-width:var(--maxw);margin:0 auto;padding:16px 24px;border-top:1px solid var(--border);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:var(--muted);font-size:12.5px}
    .footer-bottom a{color:var(--muted)}
    .section-gap{margin-top:26px}
  </style>
  <SeoHead />
</head>
<body>
  <!-- ===== 页头（整条区域底边带弧） ===== -->
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/"><span class="logo">⬢</span> TariffStack</a>
      <div class="spacer"></div>
      <div class="lang-row">
        <a class="hbtn" href="/hs-codes" data-i18n="hs_enc_btn">HS 编码百科</a>
        <a class="hbtn" href="/guides" data-i18n="guides_btn">关税指南</a>
        <span class="hsep"></span>
        <select id="lang" aria-label="Language">
          {LANGS.map(l => <option value={l.code}>{l.label}</option>)}
        </select>
        <button class="hbtn" id="theme-toggle" title="切换主题" aria-label="Toggle dark mode"><span class="tt-ico">🌙</span><span class="tt-txt" data-i18n="theme_dark">深色</span></button>
      </div>
    </div>
  </header>

  <!-- ===== Hero（无滚动条） ===== -->
  <section class="hero">
    <div class="wrap">
      <h1 data-i18n="tagline">Import Duty &amp; Landed-Cost Calculator — U.S. + China</h1>
      <p class="sub" data-i18n="hero_sub">Real official tariff stacks for importers, compliance and customs brokers: MFN / 301 / 232 / forced-labour / MPF / HMF — every layer broken down, fully sourced.</p>
      <span class="verified"><span class="dot"></span> <span data-i18n="badge_pre">✓ Rates verified against official customs data on</span> {verifiedDate} <span data-i18n="badge_tz"> (Beijing time)</span></span>
    </div>
  </section>

  <!-- ===== 主操作区：单票 + 近期变动 ===== -->
  <div class="wrap">
    <div class="grid2">
      <!-- 单票计算器（核心，最显眼） -->
      <section class="card">
        <div class="pad">
          <h2 data-i18n="section_calc">Quick calculator</h2>
          <p class="hint" data-i18n="calc_hint">Enter an HS code and goods value to see the full tariff stack broken down layer by layer.</p>

          <div class="row c3">
            <div>
              <label for="hts" data-i18n="calc_hts">HTS code</label>
              <div class="hs-wrap"><input id="hts" class="mono" placeholder="e.g. 6109.10.00" autocomplete="off" value={DEMO_HTS} /><div class="hs-list" id="hsList"></div></div>
            </div>
            <div>
              <label for="origin" data-i18n="calc_origin">Origin country</label>
              <select id="origin">
                {PINNED_ORIGINS.map(iso2 => {
                  const o = ORIGINS.find(x => x.iso2 === iso2);
                  if (!o) return null;
                  return <option value={o.iso2} selected={o.iso2 === 'CN'} data-i18n-origin={o.iso2}>{originLabel(o.iso2, 'en')}</option>;
                })}
                {POPULAR_ORIGINS.map(iso2 => {
                  const o = ORIGINS.find(x => x.iso2 === iso2);
                  if (!o) return null;
                  return <option value={o.iso2} data-i18n-origin={o.iso2}>{originLabel(o.iso2, 'en')}</option>;
                })}
                {_restOrigins.map(o => <option value={o.iso2} data-i18n-origin={o.iso2} title={US_EMBARGOED.includes(o.iso2) ? 'U.S.-embargoed origin — only the China destination is available' : ''}>{originLabel(o.iso2, 'en')}</option>)}
              </select>
            </div>
            <div>
              <label for="dest" data-i18n="calc_dest">Destination market</label>
              <select id="dest">{destOpts.map(d => <option value={d} selected={d === 'US'} data-i18n-dest={d}>{destLabel(d, 'en')}</option>)}</select>
            </div>
          </div>
          <div class="row c2">
            <div>
              <label for="goods" id="goodsLabel" data-i18n="calc_goods">Goods value (USD)</label>
              <input id="goods" type="number" value="1000" min="0" step="1" />
            </div>
            <div>
              <label for="mode" data-i18n="calc_mode">Transport mode (record only)</label>
              <select id="mode">
                <option value="" data-i18n="mode_none">Unspecified</option>
                <option value="sea" data-i18n="mode_sea">Sea</option>
                <option value="air" data-i18n="mode_air">Air</option>
                <option value="rail" data-i18n="mode_rail">Rail</option>
                <option value="truck" data-i18n="mode_truck">Truck</option>
              </select>
            </div>
          </div>
          <p class="note" data-i18n="calc_mode_note">Duty is assessed on goods value (FOB); transport mode is recorded only and does not change the rate (USITC / HTSUS).</p>
          <button class="btn" id="calc" data-i18n="calc_btn">Calculate</button>

          <!-- 固定结果区（限高+滑轮） -->
          <div class="result" id="result">
            <div class="total-box"><span class="lbl" data-i18n="total_row">Total duty + fees</span><span class="amt">{usd(worked.total)}</span><span class="sub">{destLabel(worked.dest,'en')} · {usd(worked.goods)}</span></div>
            <div class="bar">{workedBar}</div>
            <div class="legend">{workedLeg}</div>
            <table>
              <thead><tr><th data-i18n="col_layer">Layer</th><th class="num" data-i18n="col_rate">Rate</th><th class="num" data-i18n="col_amount">Amount</th></tr></thead>
              <tbody>
                {worked.layers.map(l => (
                  <tr><td data-i18n-layer={l.name}>{l.name}</td><td class="num">{l.rate ? pct(l.rate) : '—'}</td><td class="num">{usd(l.amt)}</td></tr>
                ))}
                <tr class="total"><td data-i18n="total_row">Total duty + fees</td><td></td><td class="num">{usd(worked.total)}</td></tr>
              </tbody>
            </table>
            <p class="note">{worked.note}</p>
            <div class="export">
              <button id="exp-json" data-i18n="exp_json">Export JSON</button>
              <button id="exp-csv" data-i18n="exp_csv">Export CSV</button>
              <button id="single-clear" class="clear-btn" data-i18n="single_clear" style="margin-left:auto">Clear result</button>
            </div>
          </div>
        </div>
      </section>

      <!-- 右侧：近期关税变动 时间线（唯一呈现） -->
      <section class="card" id="changes">
        <div class="pad">
          <h2 data-i18n="news_title">Live tariff-policy updates</h2>
          <p class="hint" data-i18n="news_title_sub">Official sources — the only policy feed on this site (no duplicate scrollers).</p>
          <div class="timeline" id="timeline"></div>
        </div>
      </section>
    </div>

    <!-- ===== 批量计算器（次要，置后；无"加入"按钮，自动生成待算行） ===== -->
    <section class="card section-gap">
      <div class="pad">
        <h2 data-i18n="section_batch">Batch calculator</h2>
        <p class="hint" data-i18n="batch_sub2">Type or pick an HS code — a pending row is added automatically. Each row can set its own origin / market / transport / value; otherwise the shared defaults apply. Then run the batch.</p>

        <div class="binput">
          <div class="grow"><label data-i18n="batch_hs_label">HS code (type or pick — auto-adds a row)</label>
            <div class="hs-wrap"><input id="b-hs" class="mono" autocomplete="off" data-i18n-ph="batch_ph" placeholder="e.g. 6109.10.00" /><div class="hs-list" id="b-hsList"></div></div>
          </div>
          <div><label data-i18n="batch_origin">Origin (shared)</label><select id="batch-origin"></select></div>
          <div><label data-i18n="batch_dest">Market (shared)</label><select id="batch-dest">{destOpts.map(d => <option value={d} selected={d === 'US'} data-i18n-dest={d}>{destLabel(d, 'en')}</option>)}</select></div>
          <div><label data-i18n="batch_mode">Transport (shared)</label><select id="batch-mode"><option value="" data-i18n="mode_none">Unspecified</option><option value="sea" data-i18n="mode_sea">Sea</option><option value="air" data-i18n="mode_air">Air</option><option value="rail" data-i18n="mode_rail">Rail</option><option value="truck" data-i18n="mode_truck">Truck</option></select></div>
          <div><label data-i18n="batch_goods">Goods USD (shared)</label><input id="batch-goods" type="number" value="1000" min="0" step="1" /></div>
        </div>

        <div class="area-head"><span class="t"><span data-i18n="batch_pending_label">Pending rows</span> (<span id="bcount">0</span>)</span><button class="clear-btn" id="clearPending" data-i18n="batch_clear_pending">Clear pending</button></div>
        <div class="pending" id="pending"></div>

        <div class="batch-actions">
          <button class="btn" id="batch-run" data-i18n="batch_btn">Run batch</button>
          <button class="btn ghost" id="batch-dl" data-i18n="batch_dl" style="display:none">Download CSV</button>
          <span class="batch-count" id="batch-count"></span>
        </div>

        <div class="area-head" style="margin-top:16px"><span class="t" data-i18n="batch_result_label">Results</span><button class="clear-btn" id="clearBatchOut" data-i18n="batch_clear_out">Clear results</button></div>
        <div class="batch-out" id="batch-out"></div>
      </div>
    </section>
  </div>

  <!-- ===== 页尾（与正文同宽、左右安全边距） ===== -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div class="brand"><span class="logo">⬢</span> TariffStack</div>
        <p class="brand-blurb" data-i18n="footer_tagline">Free import-duty & landed-cost calculator — U.S. + China</p>
      </div>
      <div>
        <h4 data-i18n="footer_product">Product</h4>
