---
import sample from '../data/tariff_sample.json';
import overlay from '../data/policy_overlay.json';
import full from '../data/tariff_full.json';
import cnFullJson from '../data/tariff_full_cn.json';
import { computeStack, type Rate } from '../lib/calc.ts';
import { destLabel } from '../lib/destinations.ts';
import { ORIGINS, destOptionsFor, US_EMBARGOED } from '../lib/origins.ts';
import { t, originLabel, productName, PRODUCTS } from '../lib/i18n.ts';
import newsFeed from '../data/news_feed.json';

const rates = sample.rates;
const fixed = sample.fixed;

const COMPARE_ORIGINS = ['US','CN','MX','CA','DE','FR','IT','ES','NL','IE','PL','SE','BE','AT','PT','FI','DK','GR','GB','JP','KR','IN','VN','TH','TW','MY','ID','PH','SG','BD','PK','BR','AR','AU','NZ','CH','TR','ZA','SA','AE','IL'];
// For the U.S.-destination by-origin table, exclude US itself (domestic trade is
// not an import). China-destination table keeps US (US→CN is a real flow).
const COMPARE_ORIGINS_US = COMPARE_ORIGINS.filter(o => o !== 'US');
// Origin dropdown ordering per user 2026-09-04 iron rule: pinned (US, CN) at top,
// then "popular" high-traffic origins, then the rest in the file's existing order.
const PINNED_ORIGINS = ['US', 'CN'];
const POPULAR_ORIGINS = COMPARE_ORIGINS.filter(o => o !== 'US' && o !== 'CN');
const _popularSet = new Set(POPULAR_ORIGINS);
const _restOrigins = ORIGINS.filter(o => !_popularSet.has(o.iso2) && !PINNED_ORIGINS.includes(o.iso2));
// Destination options for the DEFAULT origin (CN) — CN origin → only US is valid
// (CN destination excluded by self-rule; OFAC embargo not in play for CN).
const destOpts = destOptionsFor('CN');

// SSR worked example (zero-JS, AI-crawler readable) — base pulled from the
// freshly-rebuilt full set so the GEO-cited number tracks the latest USITC rev.
const DEMO_HTS = '6109.10.00';
const fullRates = (full && typeof full === 'object') ? (full as Record<string, Rate>) : {};
const demoRates = fullRates[DEMO_HTS] ? fullRates : (rates as Record<string, Rate>);

// Product dropdown + HTS datalist are driven by the CURATED, fully-translated
// PRODUCTS catalog (real USITC HTS codes). Live calc still looks the code up in
// the full dataset (fetched client-side), so any code typed in the HTS box computes.
const products = PRODUCTS;
const newsItems = (newsFeed && (newsFeed as { items?: any[] }).items) ? (newsFeed as { items: any[] }).items : [];
const DEFAULT_DEST = 'US';
const worked = computeStack(DEFAULT_DEST, DEMO_HTS, 'CN', 1000, demoRates, fixed, overlay)!;
const compare = COMPARE_ORIGINS_US.map(o => computeStack('US', DEMO_HTS, o, 1000, demoRates, fixed, overlay)!);

// China destination real comparison table (8-digit HS 6109.10; CN origin excluded — domestic).
const cnFullRates = (cnFullJson && (cnFullJson as any).by_hs8) ? (cnFullJson as any).by_hs8 : (cnFullJson as any);
const COMPARE_ORIGINS_CN = COMPARE_ORIGINS.filter(o => o !== 'CN');
const compare_cn = COMPARE_ORIGINS_CN.map(o => computeStack('CN', '6109.10', o, 1000, demoRates, fixed, overlay, cnFullRates)!);

const verifiedDate = String(overlay.last_checked || overlay.as_of || '').slice(0, 10);
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "TariffStack — Import Duty & Landed-Cost Calculator",
  "applicationCategory": "FinanceApplication",
  "applicationSubCategory": "CustomsDutyCalculator",
  "operatingSystem": "Any",
  "inLanguage": ["en", "zh", "zh-TW", "ja", "ko", "es", "fr", "pt", "de", "it"],
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "description": "Free import duty and landed-cost calculator with multi-language UI and product-to-HS classification. U.S. full official stacked tariff (USITC HTS, subheading-level) is live; China destination official 2026 tariff schedule (State Council Tariff Commission, effective 2026-01-01) is live with REAL rates (最惠国/MFN + 暂定/provisional). Full stacked U.S. tariff: base MFN + Section 301 + forced-labour duty + MPF/HMF.",
  "dateModified": verifiedDate
});

const pct = (x: number) => (x * 100).toFixed(2) + '%';
const usd = (x: number) => '$' + x.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const effClass = (e: number) => (e > 0.3 ? 'bad' : e > 0.15 ? 'warn' : 'good');

// SSR-baked initial timestamps for the 6 time-zone clocks (so zero-JS first
// paint and crawlers see real numbers; client-side JS then re-ticks every second
// using the same Intl.DateTimeFormat / IANA tz).
const _now = new Date();
const fmtClk = (tz: string) => ({
  t: new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: tz }).format(_now),
  d: new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: '2-digit', month: 'short', timeZone: tz }).format(_now),
});
const clkBeijing    = fmtClk('Asia/Shanghai');
const clkTokyo      = fmtClk('Asia/Tokyo');
const clkDC         = fmtClk('America/New_York');
const clkLA         = fmtClk('America/Los_Angeles');
const clkBrussels   = fmtClk('Europe/Brussels');
const clkLondon     = fmtClk('Europe/London');
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>TariffStack — Import Duty &amp; Landed-Cost Calculator</title>
  <meta name="description" content={`Free import duty and landed-cost calculator with multi-language UI and product-to-HS classification. U.S. full official stacked tariff (USITC HTS, subheading-level) is live; China destination official 2026 tariff schedule (State Council Tariff Commission, effective 2026-01-01) is live with REAL rates. Verified ${verifiedDate}.`} />
  <script type="application/ld+json" set:html={jsonLd}></script>
  <style is:global>
    :root{
      --bg:#f4f6fa; --card:#ffffff; --ink:#0f172a; --ink-deep:#0b1220; --content:#334155;
      --mut:#94a3b8; --line:#e6eaf1; --line2:#d7dde8;
      --accent:#1d4ed8; --accent-soft:#eef3ff;
      --good:#15803d; --warn:#b45309; --bad:#b91c1c;
      --scroll-thumb:#c8d0dd; --scroll-thumb-hover:#a8b3c5; --scroll-track:transparent;
    }
    /* ---------- global scrollbar styling (lighter, theme-aware) ---------- */
    *{scrollbar-width:thin;scrollbar-color:var(--scroll-thumb) var(--scroll-track);}
    *::-webkit-scrollbar{width:10px;height:10px;}
    *::-webkit-scrollbar-track{background:var(--scroll-track);}
    *::-webkit-scrollbar-thumb{background:var(--scroll-thumb);border-radius:10px;border:2px solid transparent;background-clip:padding-box;}
    *::-webkit-scrollbar-thumb:hover{background:var(--scroll-thumb-hover);background-clip:padding-box;border:2px solid transparent;}
    *::-webkit-scrollbar-corner{background:transparent;}
    /* ---------- dark theme (toggled via [data-theme="dark"] on <html>) ---------- */
    [data-theme="dark"]{
      --bg:#0b1120; --card:#121a2b; --ink:#e8edf6; --ink-deep:#f4f8fd; --content:#c4cedb;
      --mut:#8b99ad; --line:#1e2a3e; --line2:#2b3a52;
      --accent:#8aa7d8; --accent-soft:#1a2740;
      --good:#6fbf9c; --warn:#d8a866; --bad:#d88686;
      --scroll-thumb:#2b3a52; --scroll-thumb-hover:#3d5070;
    }
    [data-theme="dark"] body{background:var(--bg);color:var(--content);}
    [data-theme="dark"] .clock-card,
    [data-theme="dark"] .lang-block .meta,
    [data-theme="dark"] .cls-hint,
    [data-theme="dark"] .ad-slot,
    [data-theme="dark"] .match{background:#16223a;border-color:var(--line2);}
    [data-theme="dark"] input,
    [data-theme="dark"] select{background:#0f1828;color:var(--ink);border-color:var(--line2);}
    [data-theme="dark"] .brand .badge,
    [data-theme="dark"] .lang-block .badge{background:#0f2a1c;border-color:#1c5238;color:#6fbf9c;}
    [data-theme="dark"] .pending-panel{background:#2a1c0f;border-color:#5a3a14;}
    [data-theme="dark"] .news-item{border-color:var(--line);}
    [data-theme="dark"] .news-tag{color:#a8c0e0;background:#1a2740;}
    [data-theme="dark"] .export button:hover{border-color:var(--accent);color:var(--accent);background:#1a2740;}
    [data-theme="dark"] .theme-toggle:hover{background:#1a2740;border-color:var(--accent);color:var(--accent);}
    [data-theme="dark"] .cookie{background:var(--card);border-color:var(--line2);}
    [data-theme="dark"] .exp-box,
    [data-theme="dark"] pre,
    [data-theme="dark"] code{background:#0f1828;border-color:var(--line2);color:var(--ink);}
    [data-theme="dark"] .hero{background:#16223a;border-color:var(--line2);}
    /* ---------- result-area + leftover light boxes: full dark unification ---------- */
    [data-theme="dark"] th{background:var(--card);}
    [data-theme="dark"] .real{background:#0f2a1c;border-color:#1c5238;color:#6fbf9c;}
    [data-theme="dark"] .indic{background:#2a1c0f;border-color:#5a3a14;color:#d8a866;}
    [data-theme="dark"] .banner{background:#16223a;border-color:var(--line2);color:var(--content);box-shadow:none;}
    [data-theme="dark"] .banner .b-source{color:#d8a866;}
    [data-theme="dark"] .banner .b-disclaim{color:var(--mut);}
    [data-theme="dark"] .ad-slot{background:#16223a;border-color:var(--line2);color:var(--mut);}
    [data-theme="dark"] .ad-label{background:#0f1828;color:var(--mut);}
    [data-theme="dark"] .cls-translate-hint{background:#16223a;border-color:var(--line2);color:var(--content);}
    [data-theme="dark"] .cls-hint-remind{background:#2a1c0f;border-color:#5a3a14;color:#d8a866;}
    *{box-sizing:border-box;}
    body{margin:0;font:19px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"PingFang SC","Microsoft YaHei",Arial,sans-serif;
      background:var(--bg);color:var(--content);-webkit-font-smoothing:antialiased;}
    a{color:var(--accent);}

    /* ---------- header (3-column: brand | live time-zone clocks | lang-block) ----------
       On wide screens the empty middle is filled with a live clock grid showing the
       current time in 6 customs-relevant time zones (Beijing/Tokyo/US-East/US-West/
       Brussels/London). On narrower screens the clocks collapse below the brand. */
    /* ====================================================================
       Responsive header — 4-stage breakpoints so the 3-column layout
       (brand | live clock grid | lang-block) collapses GRACEFULLY through
       every window size without crowding/clipping.
       ==================================================================== */
    header{background:var(--card);border-bottom:1px solid var(--line);}
    /* WIDE: ≥1280 — 3-column with EXPLICIT 1:2:1 proportions (用户确认这版三列比例正确).
       Brand/Right 用 minmax(min,1fr) 上限固定为 1fr，Middle 用 2fr 拿双倍空间。
       中间列 2fr 在 1280 视口下约 550px，足够放下 3×2 时钟（3×185px）不挤、无空白。 */
    .hd-inner{max-width:1700px;margin:0 auto;padding:24px 56px;
      display:grid;grid-template-columns:minmax(260px,1fr) minmax(0,2fr) minmax(300px,1fr);align-items:start;gap:28px;}

    /* MID-WIDE: 1100–1279 — 收紧比例到 1:1.5:1（1100–1280 必单独处理）。 */
    @media (max-width:1279px){
      .hd-inner{padding:22px 36px;gap:20px;
        grid-template-columns:minmax(220px,1fr) minmax(0,1.5fr) minmax(260px,1fr);}
      .clock-bar{gap:8px;}
      .clock-card{padding:8px 10px;}
      .clock-card .clk-city{font-size:11px;letter-spacing:.04em;}
      .clock-card .clk-time{font-size:16px;}
      .clock-card .clk-date{font-size:10.5px;}
      .clock-card .clk-off{font-size:10.5px;}
      .lang-block .tag{font-size:16.5px;}
      .lang-block .tag2{font-size:13.5px;}
      .lang-block .meta{font-size:12.5px;padding:9px 12px;gap:4px;}
      .lang-block .meta .row .k{font-size:10.5px;}
    }

    /* NARROW-DESKTOP: 900–1099 — drop the clock to 2 columns
       (brand | lang-block); 6 clocks + lang-block in the same row would
       force everything to <90px and clip city names. */
    @media (max-width:1099px){
      .hd-inner{grid-template-columns:minmax(0,min-content) minmax(0,1fr);
        gap:18px;padding:18px 24px;}
      .clock-bar{display:none;}
    }

    /* TABLET: ≤900 — single column; clocks come back as a 3-col grid
       underneath brand/lang-block. */
    @media (max-width:900px){
      .hd-inner{padding:16px 20px;grid-template-columns:1fr;gap:14px;}
      /* mobile: 3×2 grid 紧凑排版，不强制 6 列（屏幕不够） */
      .clock-bar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));max-width:100%;justify-self:stretch;gap:10px;}
      .clock-card .clk-city{font-size:11.5px;}
      .clock-card .clk-time{font-size:18px;}
      .lang-block{align-items:flex-start;text-align:left;max-width:100%;}
      .lang-block .meta{align-items:flex-start;text-align:left;padding:10px 12px;}
      .lang-block .meta .row{justify-content:flex-start;}
      .lang-block .badge{align-self:flex-start;}
      .lang-block .tag{font-size:17px;}
      .lang-block .tag2{font-size:14px;}
    }

    /* MOBILE: ≤560 — clocks drop to 2 columns + tighter padding so they
       don't crowd on a 360-wide viewport. */
    @media (max-width:560px){
      .clock-bar{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;}
      .clock-card{padding:7px 10px;}
      .clock-card .clk-city{font-size:10.5px;letter-spacing:.04em;}
      .clock-card .clk-time{font-size:16px;}
      .clock-card .clk-date{font-size:10px;}
      .clock-card .clk-off{font-size:10px;}
      .lang-block .meta{font-size:12.5px;padding:9px 11px;}
      .lang-block .meta .row .k{font-size:10.5px;}
    }

    .brand{display:flex;flex-direction:column;align-items:flex-start;min-width:0;}
    .brand h1{margin:0;font-size:clamp(28px,2.6vw,40px);line-height:1.05;font-weight:800;color:var(--ink);letter-spacing:-.02em;}
    .brand .tag{margin-top:10px;font-size:clamp(15px,1.4vw,19px);color:var(--ink);font-weight:600;line-height:1.4;}
    .brand .badge{display:inline-block;margin-top:12px;font-size:14px;color:var(--good);background:#ecfdf3;border:1px solid #c8f0d4;border-radius:999px;padding:6px 16px;font-weight:600;}
    .brand .lang-row{margin-top:14px;}

    /* MIDDLE: clock bar (real-time, updated every second by JS).
       用户要求：一排 3 个时钟、共 2 排（3×2）。用 repeat(3,minmax(0,1fr)) 写死 3 列——
       永远 3 列 2 行、不换行、中间列 2fr 宽度下每格约 185px 不挤。
       minmax(0,1fr) 下限 0：窄屏格子自动收缩，不撑大父容器。
       justify-self:stretch 让它撑满中间列宽（无列间空白）。 */
    .clock-bar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;
      align-self:start;justify-self:stretch;max-width:100%;min-width:0;}
    .clock-card{background:#fafbfd;border:1px solid var(--line);border-radius:9px;
      padding:9px 12px;display:flex;flex-direction:column;gap:1px;min-width:0;
      transition:border-color .2s ease;}
    .clock-card:hover{border-color:#d6e2ff;}
    .clock-card .clk-city{font-size:11.5px;color:var(--mut);text-transform:uppercase;
      letter-spacing:.05em;font-weight:700;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .clock-card .clk-time{font-size:clamp(18px,1.5vw,21px);font-weight:800;color:var(--ink-deep);
      font-variant-numeric:tabular-nums;letter-spacing:-.01em;line-height:1.15;
      font-family:"SF Mono","Cascadia Mono","Consolas",ui-monospace,monospace;}
    .clock-card .clk-date{font-size:11px;color:var(--mut);font-variant-numeric:tabular-nums;line-height:1.3;}
    .clock-card .clk-off{color:var(--accent);font-weight:700;}

    /* RIGHT column: tagline + meta + badge + language selector — right-aligned */
    .lang-block{display:flex;flex-direction:column;align-items:flex-end;text-align:right;gap:9px;max-width:560px;min-width:0;overflow-wrap:break-word;}
    .lang-block .tag{font-size:18px;color:var(--ink);font-weight:700;line-height:1.4;letter-spacing:-.005em;overflow-wrap:anywhere;max-width:100%;}
    .lang-block .tag2{font-size:14.5px;color:var(--content);font-weight:500;line-height:1.5;overflow-wrap:anywhere;word-break:normal;max-width:100%;}
    .lang-block .tag2 b{color:var(--accent);font-weight:700;}
    /* meta panel: structured key/value, monospaced values, divider between rows, only on the right column */
    .lang-block .meta{display:flex;flex-direction:column;gap:5px;font-size:13.5px;color:var(--ink);line-height:1.45;
      background:#fafbfd;border:1px solid var(--line);border-radius:9px;padding:10px 14px;text-align:right;}
    .lang-block .meta b{color:var(--accent);font-weight:700;font-variant-numeric:tabular-nums;}
    .lang-block .meta .row{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;align-items:baseline;}
    .lang-block .meta .row .k{color:var(--mut);text-transform:uppercase;letter-spacing:.04em;font-size:11.5px;font-weight:600;flex:0 0 auto;}
    .lang-block .meta .row .v{color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums;flex:0 0 auto;}
    .lang-block .badge{display:inline-block;font-size:13.5px;color:var(--good);background:#ecfdf3;border:1px solid #c8f0d4;border-radius:999px;padding:6px 16px;font-weight:600;align-self:flex-end;}
    .lang-row{display:flex;align-items:center;gap:10px;}
    .lang-row label{margin:0;font-size:12px;color:var(--mut);text-transform:uppercase;letter-spacing:.06em;font-weight:600;}
    .lang-row select{font-size:14.5px;color:var(--ink);background:var(--card);border:1px solid var(--line2);border-radius:9px;padding:8px 12px;cursor:pointer;width:auto;}
    .theme-toggle{display:inline-flex;align-items:center;gap:6px;font-size:14.5px;font-weight:600;color:var(--ink);background:var(--card);border:1px solid var(--line2);border-radius:9px;padding:8px 12px;cursor:pointer;line-height:1;white-space:nowrap;}
    .theme-toggle:hover{border-color:var(--accent);color:var(--accent);}
    .theme-toggle .tt-ico{font-size:15px;line-height:1;}
    [data-theme="dark"] .theme-toggle{background:#0f1828;color:var(--ink);border-color:var(--line2);}
    @media (max-width:900px){
      .lang-block{align-items:flex-start;text-align:left;max-width:100%;}
      .lang-block .meta{align-items:flex-start;text-align:left;padding:10px 12px;}
      .lang-block .meta .row{justify-content:flex-start;}
      .lang-block .badge{align-self:flex-start;}
      .lang-block .tag{font-size:17px;}
      .lang-block .tag2{font-size:14px;}
    }
    /* on the smallest mobile screens the meta panel still looks tidy */
    @media (max-width:560px){
      .lang-block .meta{font-size:13px;padding:9px 11px;}
      .lang-block .meta .row .k{font-size:11px;}
    }

    /* ---------- main, with side gutters reserved for future ads ---------- */
    /* container widened to 1700px so right column (live result) has room for the big hero + table */
    main{max-width:1700px;margin:0 auto;padding:28px 56px 48px;}
    @media (max-width:900px){main{padding:18px 20px 32px;}}

    /* ---------- desktop two-column layout ----------
       left:  form / classifier / worked example / by-origin / ad slot  (all stacked)
       right: LIVE RESULT (big hero + table + note + export) — sticky-aligned */
    .cols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:36px;align-items:start;}
    @media (max-width:900px){.cols{grid-template-columns:1fr;gap:18px;}}

    /* ---------- section titles (distinct from body) ---------- */
    h2.sec{margin:0 0 14px;font-size:23px;font-weight:700;color:var(--ink);letter-spacing:-.01em;}
    .sec-sub{font-size:14.5px;color:var(--mut);margin:0 0 14px;line-height:1.5;}

    /* ---------- cards ---------- */
    .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:22px;box-shadow:0 1px 2px rgba(15,23,42,.04);}

    /* ---------- calculator form ---------- */
    .calc{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;align-items:end;}
    .entry{display:flex;flex-direction:column;gap:8px;min-width:0;}
    label.fld{font-size:13.5px;color:var(--mut);text-transform:uppercase;letter-spacing:.05em;font-weight:600;}
    .fld-hint{font-size:12px;color:var(--mut);opacity:.85;line-height:1.35;margin-top:-3px;word-break:break-word;}
    input,select{background:#fff;color:var(--ink);border:1px solid var(--line2);border-radius:9px;padding:12px 13px;font-size:16px;width:100%;max-width:100%;min-width:0;}
    input:focus,select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft);}
    button.btn{background:var(--accent);color:#fff;border:0;border-radius:9px;padding:13px 20px;font-size:16px;font-weight:700;cursor:pointer;text-align:center;}
    /* Calculate button: full width of its grid cell, text centered (scoped to .calc so the
       Find HS codes button inside .cls-row stays content-width). */
    .calc button.btn{width:100%;display:flex;align-items:center;justify-content:center;}
    button.btn:hover{filter:brightness(1.06);}

    /* ---------- classifier ---------- */
    .cls-head{font-size:19px;font-weight:700;color:var(--ink);margin:0 0 6px;line-height:1.35;}
    .cls-sub{font-size:14px;color:var(--content);margin:0 0 14px;line-height:1.55;}
    .cls-translate-hint{margin-top:10px;font-size:13px;line-height:1.5;color:var(--mut);background:#fffaf0;border:1px solid #f3e3bd;border-radius:8px;padding:9px 12px;}
    .cls-row{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:end;}
    .matches{margin-top:18px;display:flex;flex-direction:column;gap:10px;width:100%;max-width:100%;box-sizing:border-box;overflow:hidden;}
    .match{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;width:100%;max-width:100%;box-sizing:border-box;text-align:left;
      background:#fff;border:1px solid var(--line);border-radius:10px;padding:13px 15px;cursor:pointer;}
    .match:hover{border-color:var(--accent);background:var(--accent-soft);}
    .match .m-hts{flex:0 0 auto;font-weight:700;color:var(--accent);font-size:16px;font-variant-numeric:tabular-nums;min-width:0;}
    .match .m-desc{color:var(--content);font-size:15px;flex:1 1 auto;min-width:0;padding:0 14px;white-space:normal;overflow-wrap:break-word;word-break:break-word;}
    .match .m-rate{flex:0 0 auto;font-size:14px;color:var(--mut);white-space:nowrap;min-width:0;}
    /* mobile: stack + full wrap so long descriptions never stretch the page */
    @media (max-width:560px){
      .match{flex-direction:column;align-items:flex-start;gap:6px;padding:12px 14px;}
      .match .m-desc{padding:0;width:100%;}
      .match .m-rate{align-self:flex-start;}
    }

    /* classifier hints: ALWAYS VISIBLE (no collapse) — contains tip + post-selection reminder */
    .cls-hint{margin-top:18px;padding:14px 16px;background:#fafbfd;border:1px solid var(--line);
      border-radius:10px;}
    .cls-hint-title{font-size:14px;font-weight:700;color:var(--ink);margin:0 0 6px;line-height:1.4;}
    .cls-hint-tip{font-size:14px;color:var(--content);margin:0 0 4px;line-height:1.55;}
    .cls-hint-none{font-size:13.5px;color:var(--mut);margin:0 0 4px;line-height:1.5;font-style:italic;}
    .cls-hint-remind{margin-top:10px;padding:10px 12px;background:#fff7e8;border:1px solid #f6d78a;border-radius:8px;
      color:#7a4f00;font-size:13.5px;line-height:1.5;font-weight:600;}

    /* ---------- tables ---------- */
    table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;}
    th,td{text-align:left;padding:13px 15px;border-bottom:1px solid var(--line);font-size:16px;color:var(--content);}
    th{color:var(--mut);font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.05em;background:var(--bg);}
    tr:last-child td{border-bottom:0;}
    td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;}
    .total td{font-weight:800;color:var(--ink);border-top:2px solid var(--line2);font-size:16px;}
    .bad{color:var(--bad);font-weight:700;}
    .good{color:var(--good);font-weight:700;}
    .warn{color:var(--warn);font-weight:700;}

    /* ---------- by-origin comparison: scrollable so the section height never changes ---------- */
    .by-origin-scroll{max-height:360px;overflow-y:auto;margin-top:4px;border:1px solid var(--line);border-radius:12px;background:var(--card);}
    .by-origin-scroll table{border:0;border-radius:0;background:transparent;}
    .by-origin-scroll thead th{position:-webkit-sticky;position:sticky;top:0;background:var(--bg);z-index:2;box-shadow:inset 0 -1px 0 var(--line);}
    [data-theme="dark"] .by-origin-scroll thead th{background:var(--card);}

    /* ---------- RESULT hierarchy: side-by-side hero ----------
       LEFT column : "Effective rate [BIG-COLORED-NUMBER]"   (label + big number, baseline)
       RIGHT column: "Total duty + fees:  [BIG-DEEP-BLACK-NUMBER]"  (margin-left:auto, sticks to right edge)
       Inside each row, label and number stay on ONE line (flex-direction:row baseline),
       so the ":" never falls onto its own line. */
    .hero{display:flex;flex-direction:row;align-items:center;gap:40px;flex-wrap:wrap;
      margin:16px 0 6px;padding:20px 26px;
      background:var(--accent-soft);border:1px solid #d6e2ff;border-radius:14px;}
    .hero-row1{display:flex;flex-direction:row;align-items:baseline;gap:16px;flex-wrap:wrap;}
    .hero-row2{display:flex;flex-direction:row;align-items:baseline;gap:10px;flex-wrap:wrap;margin-left:auto;}
    .h-label{font-size:15px;color:var(--mut);text-transform:uppercase;letter-spacing:.05em;font-weight:700;}
    .h-num{font-size:48px;line-height:1;font-weight:800;color:var(--accent);font-variant-numeric:tabular-nums;}
    .h-num.good{color:var(--good);} .h-num.warn{color:var(--warn);} .h-num.bad{color:var(--bad);}
    .h-total-label{font-size:16px;color:var(--content);font-weight:700;}
    .h-total-num{font-size:48px;line-height:1;font-weight:800;color:var(--ink-deep);font-variant-numeric:tabular-nums;letter-spacing:-.01em;}

    .note{font-size:14px;color:var(--mut);margin-top:10px;line-height:1.6;}
    .indic{font-size:13.5px;color:#7a4f00;margin-top:12px;padding:10px 13px;background:#fff7e8;border:1px solid #f6d78a;border-radius:9px;line-height:1.55;}
    .real{font-size:13.5px;color:#146c43;margin-top:12px;padding:10px 13px;background:#ecfdf3;border:1px solid #abefc6;border-radius:9px;line-height:1.55;}
    /* header banner: aligned width with header/main (max-width:1700px), prominent, appears under site header */
    .banner-wrap{max-width:1700px;margin:18px auto 0;padding:0 56px;}
    .banner{display:flex;align-items:flex-start;gap:12px;font-size:14px;line-height:1.6;color:#7a4f00;
      background:linear-gradient(180deg,#fffdf3 0%,#fff7e8 100%);border:1px solid #f6d78a;border-left:4px solid var(--warn);border-radius:10px;
      padding:14px 18px;margin:0;font-weight:500;box-shadow:0 1px 2px rgba(180,83,9,.04);}
    .banner .b-ico{font-size:18px;line-height:1.4;flex:0 0 auto;}
    .banner .b-source{font-weight:800;color:#92400e;margin-right:4px;}
    .banner .b-disclaim{color:#7a4f00;}
    @media (max-width:900px){.banner-wrap{padding:0 20px;margin-top:14px;}}
    @media (max-width:560px){
      .banner{font-size:13px;padding:11px 13px;gap:10px;}
      .banner .b-ico{font-size:16px;}
}
    .export{margin-top:18px;display:flex;gap:12px;flex-wrap:wrap;}
    .export button{background:var(--card);color:var(--ink);border:1px solid var(--line2);border-radius:9px;padding:11px 18px;font-size:15px;font-weight:600;cursor:pointer;}
    .export button:hover{border-color:var(--accent);color:var(--accent);}
    /* ---------- footer ---------- */
    .site-footer{margin:40px auto 0;max-width:1700px;padding:30px 56px 36px;
      color:var(--mut);font-size:15px;line-height:1.6;
      display:flex;flex-wrap:wrap;gap:18px 28px;justify-content:space-between;align-items:flex-start;}
    .site-footer .ft-brand{font-weight:800;color:var(--ink);font-size:15px;letter-spacing:-.005em;}
    .site-footer .ft-links{display:flex;flex-direction:column;gap:5px;}
    .site-footer .ft-right{display:flex;gap:48px;align-items:flex-start;}
    .site-footer .ft-links a{color:var(--ink);font-weight:600;text-decoration:none;font-size:15px;}
    .site-footer .ft-links a:hover{color:var(--accent);}
    .site-footer .ft-meta{font-size:15px;color:var(--mut);max-width:680px;}
    .site-footer .ft-contact{display:grid;grid-template-columns:auto 1fr;column-gap:8px;row-gap:2px;align-items:baseline;min-width:0;}
    .site-footer .ft-label{font-weight:700;color:var(--ink);font-size:15px;line-height:1.7;white-space:nowrap;}
    .site-footer .ft-label::after{content:":";}
    .site-footer .ft-spacer{content:"";}
    .site-footer .ft-email-line{display:block;white-space:nowrap;color:var(--ink);font-weight:500;text-decoration:none;font-size:15px;line-height:1.7;}
    .site-footer .ft-email-line:hover{color:var(--accent);}
    .site-footer .ft-note{color:var(--mut);font-weight:400;margin-left:4px;}
    @media (max-width:900px){.site-footer .ft-contact{align-items:flex-start;}}

    /* full-width footer divider (spans the viewport, not the 1700px container) */
    .site-divider{width:100%;height:0;border-top:1px solid var(--line);}

    /* news ticker: vertical auto-scroll of daily real tariff-policy headlines */
    .news-ticker{margin-top:10px;width:100%;max-width:560px;}
    .news-head{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--mut);margin-bottom:7px;}
    .news-viewport{position:relative;height:104px;overflow:hidden;border:1px solid var(--line2);border-radius:9px;background:var(--card);}
    .news-track{list-style:none;margin:0;padding:0;animation:newsScroll 22s linear infinite;}
    .news-viewport:hover .news-track{animation-play-state:paused;}
    .news-item{display:flex;gap:10px;align-items:baseline;padding:10px 14px;font-size:14.5px;line-height:1.5;color:var(--ink);}
    .news-tag{flex:0 0 auto;font-size:11px;font-weight:800;letter-spacing:.04em;color:var(--accent);background:var(--accent-soft);border-radius:5px;padding:2px 7px;}
    .news-text{flex:1 1 auto;overflow-wrap:anywhere;}
    @keyframes newsScroll{from{transform:translateY(0);}to{transform:translateY(-50%);}}
    @media (prefers-reduced-motion: reduce){.news-track{animation:none;}}
    @media (max-width:900px){.news-ticker{max-width:100%;}}

    /* ---------- cookie banner (sticky-bottom, dismissible, localStorage-tracked) ---------- */
    .cookie{position:fixed;left:14px;right:14px;bottom:14px;z-index:50;
      background:var(--card);border:1px solid var(--line2);border-left:4px solid var(--accent);
      border-radius:12px;padding:14px 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;
      box-shadow:0 12px 36px rgba(15,23,42,.12);font-size:14px;color:var(--content);line-height:1.55;
      max-width:1200px;margin:0 auto;}
    .cookie .c-text{flex:1 1 auto;min-width:240px;}
    .cookie .c-text a{color:var(--accent);font-weight:700;}
    .cookie .c-btn{flex:0 0 auto;background:var(--accent);color:#fff;border:0;border-radius:9px;padding:10px 18px;font-weight:700;font-size:14px;cursor:pointer;}
    .cookie .c-btn:hover{filter:brightness(1.06);}
    .cookie.hidden{display:none;}
    @media (max-width:900px){.site-footer{padding:22px 20px 28px;flex-direction:column;gap:14px;}.site-footer .ft-right{flex-direction:column;gap:14px;}}
    @media (max-width:600px){.cookie{left:8px;right:8px;bottom:8px;padding:12px 14px;gap:10px;font-size:13.5px;}
      .cookie .c-btn{padding:9px 14px;font-size:13.5px;}}

    .empty{color:var(--mut);font-style:italic;font-size:15px;}
    .pending-panel{margin-top:12px;padding:14px 16px;background:#fff7ed;border:1px solid #fed7aa;border-radius:11px;}
    .pending-panel .pending{font-size:14.5px;color:#9a3412;line-height:1.6;margin:0;}
    .pending-panel .note{margin-top:8px;color:var(--mut);}

    /* ---------- ad placeholder (right-rail reserved for future AdSense) ---------- */
    .ad-slot{margin-top:26px;border:1px dashed var(--line2);border-radius:12px;padding:22px;background:#fafbfd;
      display:flex;align-items:center;gap:14px;min-height:140px;color:var(--mut);font-size:14px;line-height:1.6;}
    .ad-slot .ad-label{flex:0 0 auto;background:#eef1f6;color:var(--mut);font-weight:700;font-size:12px;
      letter-spacing:.08em;padding:5px 10px;border-radius:6px;}

    /* small-screen responsive tweaks */
    @media (max-width:900px){
      .hero .h-num{font-size:40px;}
      .hero .h-total-num{font-size:40px;}
      .brand h1{font-size:32px;}
      /* Single column on tablet/mobile so labels & inputs stack vertically
         (avoid the 2-col auto-fit crushing labels into adjacent columns). */
      .calc{grid-template-columns:1fr;}
    }
    @media (max-width:560px){
      .hero{flex-direction:column;gap:14px;align-items:flex-start;padding:14px 16px;}
      .hero .h-num{font-size:36px;}
      .hero .h-total-num{font-size:36px;}
      .brand h1{font-size:28px;}
    }
  </style>
</head>
<body>
  <header>
    <div class="hd-inner">
      <div class="brand">
        <h1 data-i18n="app_name">TariffStack</h1>
        <div class="tag" data-i18n="tagline">Import Duty &amp; Landed-Cost Calculator — U.S. + China</div>
        <div class="badge"><span data-i18n="badge_pre">✓ Rates verified against official USITC data on</span> {verifiedDate}</div>
        <div class="lang-row">
          <label for="lang" data-i18n="lang_label">Language</label>
          <select id="lang">
            <option value="en">English</option>
            <option value="zh">中文（简体）</option>
            <option value="zh-TW">中文（繁體）</option>
            <option value="ja">日本語</option>
            <option value="ko">한국어</option>
            <option value="es">Español</option>
            <option value="fr">Français</option>
            <option value="pt">Português</option>
            <option value="de">Deutsch</option>
            <option value="it">Italiano</option>
          </select>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode" title="切换深色 / 浅色">
            <span class="tt-ico">🌙</span><span class="tt-txt" data-i18n="theme_dark">深色</span>
          </button>
        </div>
      </div>

      <!-- ===== MIDDLE: real-time clock grid (customs-relevant time zones) =====
           SSR fills an initial server-side timestamp so the first paint (and any
           zero-JS crawler) still sees real numbers; client-side JS then updates
           every second via Intl.DateTimeFormat with the IANA tz from data-tz. -->
      <div class="clock-bar" id="clock-bar" data-i18n-aria="clock_aria" aria-label="Live clocks for major customs jurisdictions">
        <div class="clock-card" data-tz="Asia/Shanghai"><span class="clk-city" data-i18n="clk_beijing">Beijing</span><span class="clk-time">{clkBeijing.t}</span><span class="clk-date">{clkBeijing.d}</span><span class="clk-off">UTC+8</span></div>
        <div class="clock-card" data-tz="Asia/Tokyo"><span class="clk-city" data-i18n="clk_tokyo">Tokyo</span><span class="clk-time">{clkTokyo.t}</span><span class="clk-date">{clkTokyo.d}</span><span class="clk-off">UTC+9</span></div>
        <div class="clock-card" data-tz="America/New_York"><span class="clk-city" data-i18n="clk_dc">Washington DC</span><span class="clk-time">{clkDC.t}</span><span class="clk-date">{clkDC.d}</span><span class="clk-off">EST/EDT</span></div>
        <div class="clock-card" data-tz="America/Los_Angeles"><span class="clk-city" data-i18n="clk_la">Los Angeles</span><span class="clk-time">{clkLA.t}</span><span class="clk-date">{clkLA.d}</span><span class="clk-off">PST/PDT</span></div>
        <div class="clock-card" data-tz="Europe/Brussels"><span class="clk-city" data-i18n="clk_brussels">Brussels (EU)</span><span class="clk-time">{clkBrussels.t}</span><span class="clk-date">{clkBrussels.d}</span><span class="clk-off">CET/CEST</span></div>
        <div class="clock-card" data-tz="Europe/London"><span class="clk-city" data-i18n="clk_london">London</span><span class="clk-time">{clkLondon.t}</span><span class="clk-date">{clkLondon.d}</span><span class="clk-off">GMT/BST</span></div>
      </div>

      <div class="lang-block">
        <div class="tag2"><b data-i18n="tagline2_pre">U.S. full official stacked tariff</b> · <span data-i18n="tagline2_post">China (official 2026 tariff schedule - live, real rates)</span></div>
        <div class="news-ticker">
          <div class="news-head" data-i18n="news_title">Live tariff-policy updates</div>
          <div class="news-viewport" role="list" aria-live="polite">
            <ul class="news-track">
              {newsItems.concat(newsItems).map(n => (
                <li class="news-item" role="listitem"><span class="news-tag" data-i18n-dest={n.tag}>{destLabel(n.tag, 'en')}</span><span class="news-text" data-i18n={n.key}>{t('en', n.key).replace('{rev}', String(overlay.base_hts_revision ?? '')).replace('{date}', overlay.base_hts_date || overlay.as_of || '')}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ===== top-of-page legal banner: data provenance + standard "not filing advice" disclaimer ===== -->
  <div class="banner-wrap">
    <div class="banner" data-i18n-html="banner_header"><span class="b-ico">📚</span><span><span class="b-source">Data aggregated from authoritative open-data feeds</span> · USITC HTS · Federal Register · USTR · CBP CROSS · U.S. Census Bureau · UN Comtrade (cross-verified nightly). <span class="b-disclaim">Before filing any entry, return or refund, always confirm with the destination country's official customs authority or a licensed customs broker.</span></span></div>
  </div>

  <main>
    <div class="cols">
      <!-- ===== LEFT: calculator + classifier (input side) ===== -->
      <div class="col-left">
        <h2 class="sec" data-i18n="section_calc">Quick calculator</h2>
        <section class="card calc">
          <div class="entry">
            <label class="fld" for="hts" data-i18n="calc_hts">HTS code</label>
            <input id="hts" placeholder="e.g. 6109.10.00" autocomplete="off" value={DEMO_HTS} />
          </div>
          <div class="entry">
            <label class="fld" for="product" data-i18n="calc_product">…or pick a product</label>
            <select id="product"><option value="" data-i18n="calc_select">— select —</option>{products.map(p => <option value={p.hts} data-i18n-prod={p.hts}>{p.names.en} — {p.hts}</option>)}</select>
          </div>
          <div class="entry">
            <label class="fld" for="goods" id="goodsLabel" data-i18n="calc_goods">Goods value (USD)</label>
            <input id="goods" type="number" value="1000" min="0" step="1" />
          </div>
          <div class="entry">
            <label class="fld" for="origin" data-i18n="calc_origin">Origin country</label>
            <select id="origin">
              {PINNED_ORIGINS.map(iso2 => {
                const o = ORIGINS.find(x => x.iso2 === iso2);
                if (!o) return null;
                return <option value={o.iso2} selected={o.iso2 === 'CN'} data-i18n-origin={o.iso2}>{originLabel(o.iso2, 'en')}</option>;
              })}
              {POPULAR_ORIGINS.map(iso2 => {
                const o = ORIGINS.find(x => x.iso2 === iso2);
                if (!o) return null;
                return <option value={o.iso2} data-i18n-origin={o.iso2}>{originLabel(o.iso2, 'en')}</option>;
              })}
              {_restOrigins.map(o => <option value={o.iso2} data-i18n-origin={o.iso2} title={US_EMBARGOED.includes(o.iso2) ? 'U.S.-embargoed origin — only the China destination is available' : ''}>{originLabel(o.iso2, 'en')}</option>)}
            </select>
          </div>
          <div class="entry">
            <label class="fld" for="dest" data-i18n="calc_dest">Destination market</label>
            <select id="dest">{destOpts.map(d => <option value={d} selected={d === 'US'} data-i18n-dest={d}>{destLabel(d, 'en')}</option>)}</select>
          </div>
          <div class="entry">
            <button class="btn" id="calc" data-i18n="calc_btn">Calculate</button>
          </div>
        </section>

        <section class="card" style="margin-top:18px;">
          <div class="cls-head" data-i18n="classify_title">Don't know the HS code? Describe the product</div>
          <div class="cls-sub" data-i18n="classify_sub">We match your words against 25,903 U.S. HTS records and suggest the closest codes.</div>
          <div class="cls-row">
            <input id="desc" data-i18n-ph="classify_ph" placeholder="e.g. stainless steel water bottle / 不锈钢保温杯" autocomplete="off" />
            <button class="btn" id="cls-btn" data-i18n="classify_btn">Find HS codes</button>
          </div>
          <div class="cls-translate-hint" data-i18n="classify_translate_hint">Search results are shown in English by default. To read them in your language, use your browser's built-in translate (right-click → Translate). Mainland China users: we recommend Edge or Firefox for translation.</div>
          <div class="matches" id="matches"></div>
          <!-- classifier hints: ALWAYS VISIBLE (no collapse) — contains tip + post-selection reminder -->
          <div class="cls-hint" id="cls-hint">
            <strong class="cls-hint-title" data-i18n="classify_hints_title">How matching works</strong>
            <div class="cls-hint-tip" data-i18n="classify_hint">Top matches (keyword match, English works best).</div>
            <div class="cls-hint-none" data-i18n="classify_none">No match. Try different keywords (English works best).</div>
            <div class="cls-hint-remind" data-i18n="classify_reminder">After you pick a product from the list, don’t forget to set the goods value and origin country above and press Calculate.</div>
          </div>
        </section>

        <!-- ===== LIVE RESULT — sits directly under the classifier =====
             SSR-baked default (so zero-JS crawlers + first paint see a real result);
             JS re-renders this on every Calculate / input change. -->
        <section id="result" style="margin-top:18px;">
          <h2 class="sec"><span data-i18n="section_result">Calculation result</span> — HTS {worked.hts} · <span data-i18n-dest={worked.dest}>{destLabel(worked.dest, 'en')}</span> · <span data-i18n-origin={worked.origin}>{originLabel(worked.origin, 'en')}</span> · {usd(worked.goods)}</h2>
          <div class="hero">
            <div class="hero-row1">
              <span class="h-label" data-i18n="eff_row">Effective rate</span>
              <span class={`h-num ${effClass(worked.effective)}`}>{pct(worked.effective)}</span>
            </div>
            <div class="hero-row2">
              <span class="h-total-label" data-i18n="total_row">Total duty + fees</span><span class="h-total-label">:</span>
              <span class="h-total-num">{usd(worked.total)}</span>
            </div>
          </div>
          <table>
            <thead><tr><th data-i18n="col_layer">Layer</th><th class="num" data-i18n="col_rate">Rate</th><th class="num" data-i18n="col_amount">Amount</th></tr></thead>
            <tbody>
              {worked.layers.map(l => (
                <tr><td data-i18n-layer={l.name}>{l.name}</td><td class="num">{l.rate ? pct(l.rate) : '—'}</td><td class="num">{usd(l.amt)}</td></tr>
              ))}
              <tr class="total"><td data-i18n="total_row">Total duty + fees</td><td></td><td class="num">{usd(worked.total)}</td></tr>
            </tbody>
          </table>
          <p class="note">{worked.note}</p>
        </section>
        <div class="export">
          <button id="exp-json" data-i18n="exp_json">Export JSON</button>
          <button id="exp-csv" data-i18n="exp_csv">Export CSV</button>
        </div>
      </div>

      <!-- ===== RIGHT: worked example + by-origin + ad slot ===== -->
      <div class="col-right">
        <!-- ===== side-by-side by origin: UNITED STATES ===== -->
        <section style="margin-top:24px;">
          <h2 class="sec" data-i18n="section_byorigin_us">Import duty to the United States — by origin country</h2>
          <div class="sec-sub" data-i18n="sec_sub">HTS 6109.10.00 · $1,000 goods</div>
          <div class="by-origin-scroll">
          <table>
            <thead><tr><th data-i18n="col_origin">Origin</th><th class="num" data-i18n="col_eff">Effective rate</th><th class="num" data-i18n="col_total">Total</th></tr></thead>
            <tbody>
              {compare.map(c => (
                <tr>
                  <td data-i18n-origin={c.origin}>{originLabel(c.origin, 'en')}</td>
                  <td class={`num ${effClass(c.effective)}`}>{pct(c.effective)}</td>
                  <td class="num">{usd(c.total)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
          <p class="note" data-i18n="note_byorigin_us">U.S. stacking: base MFN + Section 301 (List 4A, China only) + forced-labour 12.5% + MPF/HMF. USMCA partners MX/CA and other FTA countries get MFN waived. Real rate estimates — confirm with CBP or a licensed broker.</p>
        </section>

        <!-- ===== side-by-side by origin: CHINA ===== -->
        <section style="margin-top:24px;">
          <h2 class="sec" data-i18n="section_byorigin_cn">Import duty to China — by origin country</h2>
          <div class="sec-sub">HS 6109.10 · ¥7,200 goods (≈ $1,000)</div>
          <div class="by-origin-scroll">
          <table>
            <thead><tr><th data-i18n="col_origin">Origin</th><th class="num" data-i18n="col_eff">Effective rate</th><th class="num" data-i18n="col_total">Total</th></tr></thead>
            <tbody>
              {compare_cn.map(c => (
                <tr>
                  <td data-i18n-origin={c.origin}>{originLabel(c.origin, 'en')}</td>
                  <td class={`num ${effClass(c.effective)}`}>{pct(c.effective)}</td>
                  <td class="num">{usd(c.total)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
          <p class="note" data-i18n="note_byorigin_cn">China applies the official 2026 Import & Export Tariff (State Council Tariff Commission, effective 2026-01-01). Applied duty = provisional rate (暂定税率) when lower, otherwise MFN (最惠国税率). Real published rates, not estimates.</p>
        </section>

        <!-- ad placeholder: right column bottom — reserved side rail for future Google AdSense -->
        <aside class="ad-slot" aria-label="advertisement placeholder">
          <span class="ad-label">AD</span>
          <span data-i18n="ad_placeholder">Sponsored slot — reserved for future Google AdSense.</span>
        </aside>
      </div>
    </div>

  </main>

  <!-- ===== full-width divider ===== -->
  <div class="site-divider"></div>

  <!-- ===== site footer (brand left, legal + contact clustered right) ===== -->
  <footer class="site-footer">
    <div>
      <div class="ft-brand">TariffStack</div>
      <div class="ft-meta" data-i18n="footer_tagline">Free import-duty & landed-cost calculator — U.S. + China</div>
    </div>
    <div class="ft-right">
      <div class="ft-links">
        <a href="/about" data-i18n="footer_about">About TariffStack</a>
        <a href="/guides" data-i18n="footer_guides">Tariff Guides</a>
        <a href="/terms" data-i18n="footer_terms">Terms of Service & Disclaimer</a>
        <a href="/privacy" data-i18n="footer_privacy">Advertising & Privacy</a>
      </div>
      <div class="ft-contact">
        <span class="ft-label" data-i18n="footer_contact">联系我们</span>
        <a class="ft-email-line" href="mailto:TariffStack@outlook.com">TariffStack@outlook.com<span class="ft-note" data-i18n="footer_contact_note1">（团队官方邮箱）</span></a>
        <span class="ft-spacer"></span>
        <a class="ft-email-line" href="mailto:zmarkz123zxc@gmail.com">zmarkz123zxc@gmail.com<span class="ft-note" data-i18n="footer_contact_biz_note">（商务合作）</span></a>
      </div>
    </div>
  </footer>

  <!-- ===== cookie / consent banner (sticks to bottom, dismissible, recorded in localStorage) ===== -->
  <div class="cookie hidden" id="cookie">
    <div class="c-text">
      <span data-i18n="cookie_banner">TariffStack is supported by advertising. We display contextual and personalized ads via Google AdSense to keep this tool free. Google may set cookies or use identifiers to deliver and measure ads. Your language and last calculation are stored only in your own browser. By continuing, you accept this and our</span>
      <a href="/terms" data-i18n="cookie_terms_link">Terms of Service</a>
      <span data-i18n="cookie_and">and</span>
      <a href="/privacy" data-i18n="cookie_privacy_link">Advertising & Privacy</a>.
    </div>
    <button class="c-btn" id="cookie-btn" data-i18n="cookie_btn">Got it</button>
  </div>

  <script>
    import sample from '../data/tariff_sample.json';
    import overlay from '../data/policy_overlay.json';
    import { computeStack } from '../lib/calc.ts';
    import { destLabel } from '../lib/destinations.ts';
    import { destOptionsFor } from '../lib/origins.ts';
    import { t, layerName, originLabel, productName, descLabel, type Lang } from '../lib/i18n.ts';

    const fixed = sample.fixed;
    const sampleRates = sample.rates;
    let FULL = null;
    let cnFull = null;
    const pct = (x) => (x*100).toFixed(2) + '%';
    const usd = (x) => '$' + x.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
    const effClass = (e) => (e > 0.3 ? 'bad' : e > 0.15 ? 'warn' : 'good');

    let LANG = (localStorage.getItem('ts-lang') || 'en');
    if (!['en','zh','zh-TW','ja','ko','es','fr','pt','de','it'].includes(LANG)) LANG = 'en';

    // ---- theme (dark/light) persisted toggle ----
    (function initTheme(){
      try {
        const saved = localStorage.getItem('ts-theme') || 'light';
        if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        const ico = document.querySelector('#theme-toggle .tt-ico');
        const txt = document.querySelector('#theme-toggle .tt-txt');
        if (ico && txt) {
          ico.textContent = saved === 'dark' ? '☀️' : '🌙';
          txt.textContent = t(LANG, saved === 'dark' ? 'theme_light' : 'theme_dark');
        }
      } catch (e) {}
    })();

    // ---- zh -> en glossary so Chinese sellers can search by describing in Chinese ----
    const ZH2EN = {
      '手机':'mobile phone','移动电话':'mobile phone','电脑':'computer','笔记本':'laptop computer','平板':'tablet',
      '电视':'television','显示器':'monitor','相机':'camera','耳机':'headphone','耳麦':'headphone','音响':'speaker',
      '衣服':'clothing','服装':'apparel clothing','衬衫':'shirt','裤子':'trousers','袜':'sock','鞋':'footwear shoe','靴':'boot',
      '玩具':'toy','婴儿':'baby','手表':'watch','包':'bag','背包':'backpack','箱':'luggage case','眼镜':'spectacles','帽':'hat cap',
      '钢铁':'steel','钢':'steel','铁':'iron','铝':'aluminum','铜':'copper','不锈钢':'stainless steel','金属':'metal',
      '塑料':'plastic','橡胶':'rubber','木':'wood','木材':'wood','竹':'bamboo','纸':'paper','棉':'cotton','丝':'silk','麻':'linen',
      '玻璃':'glass','陶瓷':'ceramic','石':'stone','大理石':'marble','水泥':'cement',
      '家具':'furniture','椅':'chair','桌':'table','床':'bed','沙发':'sofa','灯':'lamp lighting','灯具':'lamp lighting',
      '自行车':'bicycle','汽车':'motor vehicle automobile','摩托车':'motorcycle','轮胎':'tyre tire','电池':'battery',
      '机器':'machine','电机':'electric motor','发动机':'engine','泵':'pump','阀门':'valve','轴承':'bearing','螺丝':'screw','钉':'nail','工具':'tool',
      '食品':'food','米':'rice','糖':'sugar','茶':'tea','咖啡':'coffee','酒':'wine','饮料':'beverage','油':'oil','奶制品':'dairy','肉':'meat','鱼':'fish',
      '药':'pharmaceutical','药品':'pharmaceutical','化妆品':'cosmetic','香水':'perfume','洗涤':'detergent','肥':'soap',
      '医疗':'medical','口罩':'mask','注射器':'syringe','试剂':'reagent','疫苗':'vaccine',
      '建材':'building material','管':'pipe tube','板':'plate sheet','纺织':'textile','布料':'fabric','地毯':'carpet','窗帘':'curtain','毛巾':'towel',
      '电子':'electronic','电缆':'cable','电线':'wire','插头':'plug','开关':'switch','芯片':'semiconductor chip','电路':'circuit','太阳能':'solar',
      '水壶':'bottle','保温杯':'stainless steel bottle','杯':'cup','碗':'bowl','刀':'knife','锅':'pot pan','叉':'fork','匙':'spoon','瓶':'bottle','保温':'insulated',
    };
    function expandQuery(q) {
      let out = q;
      for (const [zh, en] of Object.entries(ZH2EN)) out = out.replace(new RegExp(zh, 'g'), ' ' + en + ' ');
      return out;
    }

    function classify(descRaw) {
      const isCn = (currentDest === 'CN');
      const ds = isCn ? (cnFull || {}) : (FULL || {});
      if (!ds || !Object.keys(ds).length) return [];
      // English-expanded tokens match U.S. `desc`; raw Chinese runs match China `name`.
      const enQ = expandQuery(descRaw.toLowerCase()).split(/[^a-z0-9]+/).filter(w => w.length > 2);
      const zhRaw = (descRaw.toLowerCase().match(/[\u4e00-\u9fff]+/g) || []);
      if (!enQ.length && !zhRaw.length) return [];
      const scored = [];
      for (const [hts, rec] of Object.entries(ds)) {
        if (!rec) continue;
        const desc = rec.desc || rec.name || '';
        const text = (hts + ' ' + desc).toLowerCase();
        let score = 0;
        for (const w of enQ) if (text.includes(w)) score++;
        for (const w of zhRaw) if (desc.includes(w)) score++;
        if (score > 0) {
          const rate = (rec.base !== undefined) ? rec.base : (rec.mfn || 0);
          scored.push({ hts, score, desc: desc, desc_i18n: rec.desc_i18n, rate: rate });
        }
      }
      scored.sort((a, b) => b.score - a.score || b.rate - a.rate);
      return scored.slice(0, 6);
    }

    function bestDesc(m, lang) {
      // 1) baked full translation (from translate_data.mjs) — highest quality, works behind GFW
      if (m.desc_i18n && m.desc_i18n[lang]) return m.desc_i18n[lang];
      // 2) curated product: use the hand-checked localized name
      const curated = productName(m.hts, lang);
      if (curated && curated !== m.hts) return curated;
      // 3) word-level dictionary substitution
      const d = descLabel(m.desc, lang, m.hts);
      if (d && d !== m.desc) return d;
      // 4) English source
      return m.desc;
    }

    function renderMatches() {
      const el = document.getElementById('matches');
      const list = (window.__matches) || [];
      if (!list.length) { el.innerHTML = ''; return; }
      el.innerHTML = list.map(m => `
        <button class="match" data-hts="${m.hts}">
          <span class="m-hts">${m.hts}</span>
          <span class="m-desc">${m.desc}</span>
          <span class="m-rate">${t(LANG,'match_base')} ${pct(m.rate)}</span>
        </button>`).join('');
      el.querySelectorAll('.match').forEach(b => b.addEventListener('click', () => {
        const hts = b.dataset.hts;
        document.getElementById('hts').value = hts;
        const prod = document.getElementById('product');
        if ([...prod.options].some(o => o.value === hts)) prod.value = hts;
        // Do NOT auto-calculate — let the user set goods value & origin, then press Calculate.
        const calcCard = document.querySelector('.calc');
        if (calcCard) {
          calcCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          calcCard.style.transition = 'box-shadow .3s ease';
          calcCard.style.boxShadow = '0 0 0 3px var(--accent-soft)';
          setTimeout(() => { calcCard.style.boxShadow = ''; }, 1600);
        }
      }));
    }

    function renderResult(res, targetId) {
      const el = document.getElementById(targetId || 'result');
      if (!res) {
        const sec = document.createElement('div');
        el.innerHTML = '';
        const h = document.createElement('h2'); h.className = 'sec';
        h.setAttribute('data-i18n', 'section_result'); h.textContent = t(LANG, 'section_result');
        const p = document.createElement('p'); p.className = 'empty';
        p.setAttribute('data-i18n', 'empty'); p.textContent = t(LANG, 'empty');
        el.appendChild(h); el.appendChild(p);
        return;
      }
      if (res.pending) {
        el.innerHTML = `
        <h2 class="sec"><span data-i18n="section_result">${t(LANG,'section_result')}</span> — HTS ${res.hts} · ${destLabel(res.dest, LANG)} · ${originLabel(res.origin, LANG)} · ${usd(res.goods)}</h2>
        <div class="pending-panel">
          <p class="pending" data-i18n="cn_pending">${t(LANG,'cn_pending')}</p>
          <p class="note">${res.note}</p>
        </div>`;
        return;
      }
      const rows = res.layers.map(l => `<tr><td data-i18n-layer="${l.name}">${layerName(l.name, LANG)}</td><td class="num">${l.rate?pct(l.rate):'—'}</td><td class="num">${usd(l.amt)}</td></tr>`).join('');
      el.innerHTML = `
        <h2 class="sec"><span data-i18n="section_result">${t(LANG,'section_result')}</span> — HTS ${res.hts} · ${destLabel(res.dest, LANG)} · ${originLabel(res.origin, LANG)} · ${usd(res.goods)}</h2>
        <div class="hero">
          <div class="hero-row1">
            <span class="h-label" data-i18n="eff_row">${t(LANG,'eff_row')}</span>
            <span class="h-num ${effClass(res.effective)}">${pct(res.effective)}</span>
          </div>
          <div class="hero-row2">
            <span class="h-total-label" data-i18n="total_row">${t(LANG,'total_row')}</span><span class="h-total-label">:</span>
            <span class="h-total-num">${usd(res.total)}</span>
          </div>
        </div>
        <table><thead><tr><th data-i18n="col_layer">${t(LANG,'col_layer')}</th><th class="num" data-i18n="col_rate">${t(LANG,'col_rate')}</th><th class="num" data-i18n="col_amount">${t(LANG,'col_amount')}</th></tr></thead>
        <tbody>${rows}
          <tr class="total"><td data-i18n="total_row">${t(LANG,'total_row')}</td><td></td><td class="num">${usd(res.total)}</td></tr>
        </tbody></table>
        ${!res.indicative && res.dest !== 'US' ? `<p class="real" data-i18n="dest_real">${t(LANG,'dest_real')}</p>` : ''}
        <p class="note">${res.note}</p>`;
    }

    let currentDest = 'US';
    function doCalc() {
      const hts = (document.getElementById('hts').value || document.getElementById('product').value || '').trim();
      const origin = document.getElementById('origin').value;
      const goods = parseFloat(document.getElementById('goods').value) || 0;
      const dest = document.getElementById('dest').value;
      let res = null;
      if (dest === 'CN') {
        // China: REAL official 2026 tariff schedule (parsed from published PDF).
        res = computeStack(dest, hts, origin, goods, sampleRates, fixed, overlay, cnFull);
      } else {
        const rates = FULL || sampleRates;
        res = rates[hts] ? computeStack(dest, hts, origin, goods, rates, fixed, overlay) : null;
      }
      window.__last = res;
      currentDest = dest;
      renderResult(res);
    }

    // destination-aware field hints: US = 10-digit HTS + USD; CN = 8-digit HS + CNY-assessed
    function updateFieldHints() {
      const destEl = document.getElementById('dest');
      const dest = destEl ? destEl.value : 'US';
      const hsHint = document.getElementById('hsHint');
      const htsInput = document.getElementById('hts');
      const goodsLabel = document.getElementById('goodsLabel');
      if (hsHint) hsHint.textContent = t(LANG, dest === 'CN' ? 'hs_hint_cn' : 'hs_hint_us');
      if (htsInput) htsInput.placeholder = dest === 'CN' ? 'e.g. 6109.10' : 'e.g. 6109.10.00';
      if (goodsLabel) goodsLabel.textContent = t(LANG, dest === 'CN' ? 'goods_label_cn' : 'calc_goods');
    }

    function applyLang(lang) {
      LANG = lang;
      localStorage.setItem('ts-lang', lang);
      document.documentElement.lang = lang;
      document.getElementById('lang').value = lang;
      document.querySelectorAll('[data-i18n]').forEach(e => {
        let s = t(lang, e.getAttribute('data-i18n'));
        if (s && s.indexOf('{rev}') >= 0) s = s.replace(/\{rev\}/g, String(overlay.base_hts_revision ?? '')).replace(/\{date\}/g, overlay.base_hts_date || overlay.as_of || '');
        e.textContent = s;
      });
      document.querySelectorAll('[data-i18n-aria]').forEach(e => { e.setAttribute('aria-label', t(lang, e.getAttribute('data-i18n-aria'))); });
    document.querySelectorAll('[data-i18n-html]').forEach(e => { e.innerHTML = t(lang, e.getAttribute('data-i18n-html')); });
      document.querySelectorAll('[data-i18n-ph]').forEach(e => { const k = e.getAttribute('data-i18n-ph'); if (k) e.placeholder = t(lang, k); });
      document.querySelectorAll('[data-i18n-layer]').forEach(e => { e.textContent = layerName(e.getAttribute('data-i18n-layer'), lang); });
      document.querySelectorAll('[data-i18n-origin]').forEach(e => { e.textContent = originLabel(e.getAttribute('data-i18n-origin'), lang); });
      document.querySelectorAll('[data-i18n-prod]').forEach(e => { const c = e.getAttribute('data-i18n-prod'); e.textContent = productName(c, lang) + ' — ' + c; });
      document.querySelectorAll('[data-i18n-dest]').forEach(e => { e.textContent = destLabel(e.getAttribute('data-i18n-dest'), lang); });
      updateFieldHints();
      if (window.__last) renderResult(window.__last);
      if (window.__matches && window.__matches.length) renderMatches();
    }

    // ---- classifier hints: ALWAYS VISIBLE (no collapse) ----
    // (cls-toggle button has been removed; cls-hint renders open by default in markup)

    // origin → destination linkage: only show destinations that trade with the selected origin
    // (e.g. U.S.-embargoed CU/IR/KP/SY hide "US" and show only "CN").
    function renderDestOptions(origin) {
      const sel = document.getElementById('dest');
      const opts = destOptionsFor(origin);
      sel.innerHTML = opts.map(d => `<option value="${d}" data-i18n-dest="${d}">${destLabel(d, LANG)}</option>`).join('');
      sel.value = opts.includes(sel.value) ? sel.value : (opts[0] || 'CN');
      updateFieldHints();
    }

    // events
    document.getElementById('origin').addEventListener('change', e => {
      renderDestOptions(e.target.value);
      doCalc();
    });
    document.getElementById('calc').addEventListener('click', () => {
      doCalc();
      const resEl = document.getElementById('result');
      if (resEl) resEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    document.getElementById('product').addEventListener('change', e => { document.getElementById('hts').value = e.target.value; });
    document.getElementById('hts').addEventListener('change', doCalc);
    document.getElementById('dest').addEventListener('change', () => { doCalc(); updateFieldHints(); });
    document.getElementById('lang').addEventListener('change', e => applyLang(e.target.value));
    document.getElementById('theme-toggle').addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      if (next === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      else document.documentElement.removeAttribute('data-theme');
      try { localStorage.setItem('ts-theme', next); } catch (e) {}
      const ico = document.querySelector('#theme-toggle .tt-ico');
      const txt = document.querySelector('#theme-toggle .tt-txt');
      if (ico && txt) {
        ico.textContent = next === 'dark' ? '☀️' : '🌙';
        txt.textContent = t(LANG, next === 'dark' ? 'theme_light' : 'theme_dark');
      }
    });
    document.getElementById('cls-btn').addEventListener('click', () => {
      const q = document.getElementById('desc').value;
      window.__matches = classify(q);
      renderMatches();
      if (!window.__matches.length) {
        const el = document.getElementById('matches');
        el.innerHTML = `<p class="empty" data-i18n="classify_none">${t(LANG,'classify_none')}</p>`;
      }
    });
    document.getElementById('desc').addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('cls-btn').click(); });

    function download(name, text, type) {
      const b = new Blob([text], { type });
      const u = URL.createObjectURL(b);
      const a = document.createElement('a'); a.href = u; a.download = name; a.click();
      URL.revokeObjectURL(u);
    }
    document.getElementById('exp-json').addEventListener('click', () => {
      if (!window.__last) return;
      download('tariffstack-result.json', JSON.stringify(window.__last, null, 2), 'application/json');
    });
    document.getElementById('exp-csv').addEventListener('click', () => {
      const r = window.__last; if (!r) return;
      const head = 'layer,rate,amount\n';
      const body = r.layers.map(l => `"${layerName(l.name, LANG)}",${l.rate},${l.amt.toFixed(2)}`).join('\n');
      download('tariffstack-result.csv', head + body, 'text/csv');
    });

    // load full dataset, apply saved language, render
    fetch('/data/tariff_full.json').then(r => r.json()).then(j => { FULL = j; doCalc(); })
      .catch(() => { FULL = null; doCalc(); });
    fetch('/data/tariff_full_cn.json').then(r => r.json()).then(j => { cnFull = (j && j.by_hs8) ? j.by_hs8 : j; doCalc(); })
      .catch(() => { cnFull = null; doCalc(); });
    applyLang(LANG);

    // ---- live time-zone clocks (real-time, ticked every second) ----
    (function tickClocks(){
      const cards = document.querySelectorAll('.clock-card');
      if (!cards.length) return;
      const now = new Date();
      const dFmtCache = new Map();
      cards.forEach(c => {
        const tz = c.dataset.tz;
        let tFmt = dFmtCache.get('t:'+tz);
        if (!tFmt) { tFmt = new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false,timeZone:tz}); dFmtCache.set('t:'+tz, tFmt); }
        let dFmt = dFmtCache.get('d:'+tz);
        if (!dFmt) { dFmt = new Intl.DateTimeFormat('en-GB',{weekday:'short',day:'2-digit',month:'short',timeZone:tz}); dFmtCache.set('d:'+tz, dFmt); }
        const tEl = c.querySelector('.clk-time');
        const dEl = c.querySelector('.clk-date');
        if (tEl) tEl.textContent = tFmt.format(now);
        if (dEl) dEl.textContent = dFmt.format(now);
      });
      setTimeout(tickClocks, 1000);
    })();

    // ---- cookie consent banner (first-visit only, localStorage-tracked) ----
    (function () {
      const KEY = 'ts-cookie-accepted';
      const banner = document.getElementById('cookie');
      const btn = document.getElementById('cookie-btn');
      if (!banner || !btn) return;
      if (!localStorage.getItem(KEY)) banner.classList.remove('hidden');
      btn.addEventListener('click', () => {
        localStorage.setItem(KEY, '1');
        banner.classList.add('hidden');
      });
    })();
  </script>
</body>
</html>
