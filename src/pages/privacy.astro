---
// Advertising & Privacy — standalone page (NOT a copy of the Terms).
// en + zh fully translated; other languages fall back to en (per i18n convention).
import CookieConsent from '../components/CookieConsent.astro';
const en = {
  title: 'Advertising & Privacy — TariffStack',
  h1: 'Advertising & Privacy',
  updated: 'Last updated',
  back: '← Back to TariffStack',
  toc: 'Contents',

  intro: 'TariffStack is a free, advertising-supported public-good tool that estimates import duties and landed costs. This page explains, in plain language, what data we handle, how advertising works on the site, and the choices you have. It is a supplement to our Terms of Service & Disclaimer — it does not replace them.',

  // 1. Scope
  s1_h: '1. Scope of this page',
  s1: 'This page covers only advertising and personal-data practices. Questions about liability, intellectual property, acceptable use, or governing law belong to the Terms of Service & Disclaimer. If you need the legal terms, open that page instead.',

  // 2. What we do NOT collect
  s2_h: '2. What we do NOT collect',
  s2: 'TariffStack requires no account and collects no personal profile. Your calculation inputs — the HS code, goods description, declared value, origin and destination you enter — are processed entirely in your own browser once the dataset is loaded. They are never sent to our servers and are never shared with advertisers or any third party. We do not embed third-party analytics that build a behavioural profile of you, and we do not sell or rent any personal data.',

  // 3. What we DO collect
  s3_h: '3. What we DO collect',
  s3: 'We collect only what is needed to show ads and remember your preferences: (a) advertising identifiers and cookies set by our ad provider (see section 5); and (b) two values stored in your own browser’s localStorage — your selected language and your last calculation — so the page feels consistent on return visits. We do not receive your name, email, postal address, or any government identifier.',

  // 4. Cookies & similar technologies
  s4_h: '4. Cookies & similar technologies',
  s4: 'Cookies are small text files placed on your device. On TariffStack, cookies are set almost entirely by our advertising partner to deliver and measure ads; we ourselves set only the minimal localStorage entries described above. You can clear, block or limit cookies through your browser settings at any time. Blocking ad cookies will not break the calculator — it only affects which ads you see.',

  // 5. Advertising
  s5_h: '5. Advertising (Google AdSense)',
  s5: 'The tool is kept free by displaying contextual and personalized ads served by Google AdSense. AdSense may use cookies, device or browser identifiers, and information about your previous ad interactions to select ads that are relevant to you. Personalized ads are based on advertising profiles maintained by Google, not by TariffStack. Other ad networks may be added later; any such network is bound by the same “no sale of your inputs” rule. The tariff estimates you calculate are never used as signals to target you with ads.',

  // 6. Your choices
  s6_h: '6. Your choices & opt-out',
  s6: 'You can opt out of personalized advertising at any time: (a) use Google’s Ads Settings at adssettings.google.com; (b) use the industry opt-out at aboutads.info; or (c) enable “Do Not Track” / block third-party cookies in your browser. Choosing non-personalized ads does not remove advertising — it only means ads are based on the page context rather than your profile. Declining cookies via your browser is respected by the site.',

  // 7. Third-party links
  s7_h: '7. Third-party links & their policies',
  s7: 'When an ad or link on TariffStack leads to a third-party destination — for example an ad landing page served by Google AdSense — that destination is outside our control and is governed by its own privacy policy (including Google’s Privacy & Terms for AdSense). We are not responsible for the data practices of those sites.',

  // 8. Retention & security
  s8_h: '8. Data retention & security',
  s8: 'Because your calculation inputs are never transmitted to us, we retain none of them. The advertising identifiers set by our ad partner are governed by that partner’s retention schedule. We follow reasonable technical measures to keep the site and its dataset integrity intact, but no web service can guarantee absolute security.',

  // 9. Children
  s9_h: '9. Children',
  s9: 'TariffStack is a professional trade tool not directed at children under 13. We do not knowingly collect personal data from children. If you believe a child has provided us data, contact us and we will remove it.',

  // 10. Changes
  s10_h: '10. Changes to this policy',
  s10: 'We may update this Advertising & Privacy page as our advertising or data practices change. The “Last updated” date above shows the current version. Material changes will be announced by a banner on the home page for at least fourteen (14) days before they take effect.',

  // 11. Contact
  s11_h: '11. Contact',
  s11: 'Questions about advertising or privacy can be sent to TariffStack@outlook.com, and for data-correction or takedown requests please include the HS code and destination so we can investigate. For business enquiries, contact the team lead directly at zmarkz123zxc@gmail.com.',
};

const zh = {
  title: '广告与隐私 — TariffStack',
  h1: '广告与隐私',
  updated: '最后更新',
  back: '← 返回 TariffStack',
  toc: '目录',

  intro: 'TariffStack 是一个免费、由广告支持的公益工具，用于估算进口关税与到岸成本。本页以通俗语言说明我们处理哪些数据、站内广告如何运作，以及你拥有的选择权。本页是《服务条款与免责声明》的补充，不能替代后者。',

  s1_h: '1. 本页范围',
  s1: '本页仅涉及广告与个人信息处理相关事宜。有关责任限制、知识产权、使用规范或适用法律的问题，请查阅《服务条款与免责声明》。如你需要法律条款，请打开该页面。',

  s2_h: '2. 我们不收集什么',
  s2: 'TariffStack 无需注册账号，也不收集个人画像。你输入的计算要素——HS 编码、商品描述、申报金额、原产国与目的国——在数据集加载后完全在你的浏览器本地处理，不会发送到我们的服务器，也绝不会与广告主或任何第三方共享。我们不嵌入会为你建立行为画像的第三方分析脚本，也不出售或出租任何个人数据。',

  s3_h: '3. 我们收集什么',
  s3: '我们只收集维持广告展示与记住偏好所需的最小数据：(a) 由广告合作伙伴设置的广告标识符与 Cookie（见第 5 节）；(b) 保存在你自己浏览器 localStorage 中的两个值——你选择的语言和上一次计算——以便再次访问时页面保持一致。我们不会收到你的姓名、邮箱、通信地址或任何政府证件号码。',

  s4_h: '4. Cookie 与同类技术',
  s4: 'Cookie 是存放在你设备上的小文本文件。在 TariffStack 上，Cookie 几乎全部由我们的广告合作伙伴为了投放与衡量广告而设置；我们自身仅设置上文所述的最小 localStorage 条目。你可以随时通过浏览器设置清除、屏蔽或限制 Cookie。屏蔽广告 Cookie 不会导致计算器失效——只会影响你看到的广告内容。',

  s5_h: '5. 广告（Google AdSense）',
  s5: '本工具通过展示由 Google AdSense 投放的情境化与个性化广告保持免费。AdSense 可能使用 Cookie、设备或浏览器标识符，以及你过往的广告互动信息，来挑选与你相关的广告。个性化广告基于 Google 维护的广告画像，而非 TariffStack。未来可能加入其他广告网络，任何此类网络都须遵守同样的"不出售你的输入数据"规则。你计算的关税估算结果绝不会被用作向你投放广告的信号。',

  s6_h: '6. 你的选择与退出',
  s6: '你可以随时退出个性化广告：(a) 通过 Google 广告设置 adssettings.google.com；(b) 通过行业退出平台 aboutads.info；或 (c) 在浏览器中开启"请勿追踪"/屏蔽第三方 Cookie。选择非个性化广告不会移除广告——只是广告改为基于页面上下文而非你的画像。通过浏览器拒绝 Cookie 后，本站会予以尊重。',

  s7_h: '7. 第三方链接及其政策',
  s7: '当 TariffStack 链接到外部来源——如某条 USITC HTS 章节、Federal Register 公告、CBP 裁定或广告落地页——该目的地不在我们的控制范围内，受其自身隐私政策约束（包括 Google 针对 AdSense 的隐私与条款）。我们不对这些站点的数据做法负责。',

  s8_h: '8. 数据留存与安全',
  s8: '由于你的计算输入从不传给我们，我们也不留存任何此类数据。广告合作伙伴设置的广告标识符受其自身留存周期约束。我们采取合理技术措施维护站点与数据集的完整性，但没有任何网络服务能保证绝对安全。',

  s9_h: '9. 未成年人',
  s9: 'TariffStack 是面向专业人士的贸易工具，不针对 13 岁以下儿童。我们不会明知而收集儿童个人数据。若你认为有儿童向我们提供了数据，请与我们联系，我们会予以删除。',

  s10_h: '10. 本政策的变更',
  s10: '随着广告或数据实践的变化，我们可能更新本《广告与隐私》页。上方"最后更新"日期即当前版本。重大变更将在首页以横幅预告至少十四（14）天后再生效。',

  s11_h: '11. 联系方式',
  s11: '有关广告或隐私的问题可发送至 TariffStack@outlook.com，如需数据更正或删除请求，请附上 HS 编码与目的国，以便我们核查。商务合作请直接联系团队负责人：zmarkz123zxc@gmail.com。',
};

const d = en;
import overlay from '../data/policy_overlay.json';
const pageUpdated = String(overlay.last_checked || overlay.as_of || '').slice(0, 10) || '2026-09-04';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{d.title}</title>
  <meta name="description" content="TariffStack Advertising & Privacy — what data we handle, how Google AdSense ads work on the site, and your opt-out choices." />
  <meta name="robots" content="index,follow" />
  <style is:global>
    :root{--bg:#f4f6fa;--card:#ffffff;--ink:#0f172a;--ink-deep:#0b1220;--content:#334155;--mut:#94a3b8;--line:#e6eaf1;--line2:#d7dde8;--accent:#1d4ed8;--accent-soft:#eef3ff;--good:#15803d;--warn:#b45309;--bad:#b91c1c;--scroll-thumb:#c8d0dd;--scroll-thumb-hover:#a8b3c5;--scroll-track:transparent;}
    *{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:var(--scroll-thumb) var(--scroll-track);}
    *::-webkit-scrollbar{width:10px;height:10px;}
    *::-webkit-scrollbar-track{background:var(--scroll-track);}
    *::-webkit-scrollbar-thumb{background:var(--scroll-thumb);border-radius:10px;border:2px solid transparent;background-clip:padding-box;}
    *::-webkit-scrollbar-thumb:hover{background:var(--scroll-thumb-hover);background-clip:padding-box;border:2px solid transparent;}
    *::-webkit-scrollbar-corner{background:transparent;}
    [data-theme="dark"]{
      --bg:#0b1120; --card:#121a2b; --ink:#e8edf6; --ink-deep:#f4f8fd; --content:#c4cedb;
      --mut:#8b99ad; --line:#1e2a3e; --line2:#2b3a52;
      --accent:#8aa7d8; --accent-soft:#1a2740;
      --good:#6fbf9c; --warn:#d8a866; --bad:#d88686;
      --scroll-thumb:#2b3a52; --scroll-thumb-hover:#3d5070;
    }
    [data-theme="dark"] body{background:var(--bg);color:var(--content);}
    [data-theme="dark"] .lead{background:var(--accent-soft);border-color:var(--line2);}
    [data-theme="dark"] .toc{background:#16223a;border-color:var(--line2);}
    body{margin:0;font:19px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"PingFang SC","Microsoft YaHei",Arial,sans-serif;background:var(--bg);color:var(--content);-webkit-font-smoothing:antialiased;}
    .wrap{max-width:920px;margin:0 auto;padding:32px 28px 64px;}
    header.site{background:var(--card);border-bottom:1px solid var(--line);margin-bottom:28px;}
    .site-inner{max-width:920px;margin:0 auto;padding:18px 28px;}
    .site-inner a{color:var(--accent);text-decoration:none;font-weight:700;font-size:18px;}
    .site-inner .sub{font-size:13px;color:var(--mut);margin-left:10px;}
    h1{margin:0 0 8px;font-size:34px;font-weight:800;color:var(--ink);letter-spacing:-.02em;}
    .updated{font-size:14px;color:var(--mut);margin-bottom:20px;}
    .lead{background:var(--accent-soft);border:1px solid #d6e2ff;border-left:4px solid var(--accent);border-radius:10px;padding:14px 18px;font-size:15.5px;color:var(--ink-deep);margin-bottom:24px;line-height:1.6;}
    .toc{background:#fafbfd;border:1px solid var(--line);border-radius:10px;padding:14px 18px;margin-bottom:28px;font-size:14.5px;line-height:1.8;}
    .toc ol{margin:0;padding-left:20px;}
    .toc a{color:var(--ink);text-decoration:none;font-weight:600;}
    .toc a:hover{color:var(--accent);}
    h2{margin:30px 0 10px;font-size:21px;font-weight:700;color:var(--ink);letter-spacing:-.005em;scroll-margin-top:80px;}
    p{margin:0 0 14px;line-height:1.65;}
    .back{margin-top:36px;display:inline-block;font-weight:700;}
    @media (max-width:600px){.wrap{padding:20px 16px 48px;}.site-inner{padding:14px 16px;}h1{font-size:28px;}h2{font-size:19px;}}
  </style>
</head>
<body>
  <header class="site"><div class="site-inner"><a href="/">TariffStack</a><span class="sub" data-i18n="h1">Advertising & Privacy</span></div></header>
  <main class="wrap">
    <h1 data-i18n="h1">{d.h1}</h1>
    <div class="updated"><span data-i18n="updated">{d.updated}</span>: {pageUpdated}</div>
    <div class="lead" data-i18n="intro">{d.intro}</div>

    <nav class="toc" aria-label="Table of contents">
      <strong data-i18n="toc">{d.toc}</strong>
      <ol>
        <li><a href="#s1" data-i18n="s1_h">{d.s1_h}</a></li>
        <li><a href="#s2" data-i18n="s2_h">{d.s2_h}</a></li>
        <li><a href="#s3" data-i18n="s3_h">{d.s3_h}</a></li>
        <li><a href="#s4" data-i18n="s4_h">{d.s4_h}</a></li>
        <li><a href="#s5" data-i18n="s5_h">{d.s5_h}</a></li>
        <li><a href="#s6" data-i18n="s6_h">{d.s6_h}</a></li>
        <li><a href="#s7" data-i18n="s7_h">{d.s7_h}</a></li>
        <li><a href="#s8" data-i18n="s8_h">{d.s8_h}</a></li>
        <li><a href="#s9" data-i18n="s9_h">{d.s9_h}</a></li>
        <li><a href="#s10" data-i18n="s10_h">{d.s10_h}</a></li>
        <li><a href="#s11" data-i18n="s11_h">{d.s11_h}</a></li>
      </ol>
    </nav>

    <h2 id="s1" data-i18n="s1_h">{d.s1_h}</h2><p data-i18n="s1">{d.s1}</p>
    <h2 id="s2" data-i18n="s2_h">{d.s2_h}</h2><p data-i18n="s2">{d.s2}</p>
    <h2 id="s3" data-i18n="s3_h">{d.s3_h}</h2><p data-i18n="s3">{d.s3}</p>
    <h2 id="s4" data-i18n="s4_h">{d.s4_h}</h2><p data-i18n="s4">{d.s4}</p>
    <h2 id="s5" data-i18n="s5_h">{d.s5_h}</h2><p data-i18n="s5">{d.s5}</p>
    <h2 id="s6" data-i18n="s6_h">{d.s6_h}</h2><p data-i18n="s6">{d.s6}</p>
    <h2 id="s7" data-i18n="s7_h">{d.s7_h}</h2><p data-i18n="s7">{d.s7}</p>
    <h2 id="s8" data-i18n="s8_h">{d.s8_h}</h2><p data-i18n="s8">{d.s8}</p>
    <h2 id="s9" data-i18n="s9_h">{d.s9_h}</h2><p data-i18n="s9">{d.s9}</p>
    <h2 id="s10" data-i18n="s10_h">{d.s10_h}</h2><p data-i18n="s10">{d.s10}</p>
    <h2 id="s11" data-i18n="s11_h">{d.s11_h}</h2><p data-i18n="s11">{d.s11}</p>

    <a class="back" href="/" data-i18n="back">{d.back}</a>
  </main>

  <script is:inline define:vars={{ zh }}>
    // Lightweight zh swap — mirrors the home page language preference (localStorage 'ts-lang').
    // The full `zh` dictionary is injected from the server-side object above via define:vars,
    // so the client copy can NEVER drift from the SSR source of truth.
    (function () {
      try {
        (function applyTheme(){ try { var s = localStorage.getItem('ts-theme') || 'light'; if (s === 'dark') document.documentElement.setAttribute('data-theme','dark'); } catch(e){} })();
        var lang = localStorage.getItem('ts-lang') || 'en';
        if (lang !== 'zh') return;
        var nodes = document.querySelectorAll('[data-i18n]');
        for (var i = 0; i < nodes.length; i++) {
          var k = nodes[i].getAttribute('data-i18n');
          if (zh[k] != null) nodes[i].textContent = zh[k];
        }
        document.documentElement.lang = 'zh';
        document.title = '广告与隐私 — TariffStack';
      } catch (e) {}
    })();
  </script>

  <CookieConsent />
</body>
</html>
