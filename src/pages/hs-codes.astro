---
import SeoHead from '../components/SeoHead.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { t, LANGS } from '../lib/i18n.ts';
import overlay from '../data/policy_overlay.json';

const verifiedDate = String(overlay.last_checked || overlay.as_of || '').slice(0, 10);
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "TariffStack — HS / HTS Code Encyclopedia",
  "description": "Complete official U.S. HTS and China HS code directory with real base / MFN rates, sourced from USITC and the China Tariff Commission schedule.",
  "inLanguage": ["en", "zh", "zh-TW", "ja", "ko", "es", "fr", "pt", "de", "it"],
});

// ===== GEO 修复：服务端渲染前 N 条真实税率进静态 HTML（AI 爬虫不执行 JS 也能读到真值） =====
import ssg from '../data/hs_codes_ssg.json';
const CAP = 200;
const esc = (s) => String(s)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const pct = (x) => {
  const n = Number(x);
  if (!isFinite(n) || n === 0) return { txt: 'Free', free: true };
  return { txt: (n % 1 === 0 ? n : n.toFixed(2)) + '%', free: false };
};
const usHead = `<tr><th data-i18n="hs_enc_code">Code</th><th data-i18n="hs_enc_desc">Description</th><th class="num" data-i18n="hs_enc_rate">Base rate</th><th></th></tr>`;
const usRows = ssg.us.slice(0, CAP).map(r => {
  const p = pct(r.base * 100);
  return `<tr><td class="code">${esc(r.code)}</td><td class="desc">${esc(r.desc)}<div class="tr-line" data-i18n-desc="${esc(r.desc)}" data-hts="${esc(r.code)}" hidden></div></td><td class="rate ${p.free ? 'free' : ''}">${p.txt}</td><td class="use"><a href="/?hts=${encodeURIComponent(r.code)}&dest=US" data-i18n="hs_enc_use">Use calculator</a></td></tr>`;
}).join('');
const cnRows = ssg.cn.slice(0, CAP).map(r => {
  const p = pct(r.mfn);
  const ch = r.code.slice(0, 4);
  return `<tr><td class="code">${esc(r.code)}</td><td class="desc"><span class="ch">${esc(ch)}</span>${esc(r.name)}</td><td class="rate ${p.free ? 'free' : ''}">${p.txt}</td><td class="use"><a href="/?hts=${encodeURIComponent(r.code)}&dest=CN" data-i18n="hs_enc_use">Use calculator</a></td></tr>`;
}).join('');
const usTable = `<table><thead>${usHead}</thead><tbody>${usRows}</tbody></table>`;
const cnTable = `<table><thead>${usHead}</thead><tbody>${cnRows}</tbody></table>`;
const featHead = `<tr><th data-i18n="hs_enc_code">Code</th><th data-i18n="hs_enc_desc">Description</th><th class="num" data-i18n="hs_enc_rate">Base rate</th><th></th></tr>`;
const featUsRows = ssg.featuredUs.map(r => {
  const p = pct(r.base * 100);
  return `<tr><td class="code">${esc(r.code)}</td><td class="desc">${esc(r.desc)}<div class="tr-line" data-i18n-desc="${esc(r.desc)}" data-hts="${esc(r.code)}" hidden></div></td><td class="rate ${p.free ? 'free' : ''}">${p.txt}</td><td class="use"><a href="/?hts=${encodeURIComponent(r.code)}&dest=US" data-i18n="hs_enc_use">Use calculator</a></td></tr>`;
}).join('');
const featCnRows = ssg.featuredCn.map(r => {
  const p = pct(r.mfn);
  const ch = r.code.slice(0, 4);
  return `<tr><td class="code">${esc(r.code)}</td><td class="desc"><span class="ch">${esc(ch)}</span>${esc(r.name)}</td><td class="rate ${p.free ? 'free' : ''}">${p.txt}</td><td class="use"><a href="/?hts=${encodeURIComponent(r.code)}&dest=CN" data-i18n="hs_enc_use">Use calculator</a></td></tr>`;
}).join('');
const featUsTable = `<table><thead>${featHead}</thead><tbody>${featUsRows}</tbody></table>`;
const featCnTable = `<table><thead>${featHead}</thead><tbody>${featCnRows}</tbody></table>`;
const ssgCount = `Showing <b>${Math.min(CAP, ssg.us.length)}</b> of ${ssg.meta.usTotal} U.S. HTS codes`;
const dsJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "TariffStack official U.S. HTS & China HS tariff rates",
  "description": `Real, sourced base / MFN tariff rates for ${ssg.meta.usTotal} U.S. HTS subheadings and ${ssg.meta.cnTotal} China 8-digit HS codes.`,
  "url": "https://tariff-stack.zmarkz123zxc.workers.dev/hs-codes",
  "sameAs": ["https://hts.usitc.gov/", "https://www.customs.gov.cn/"],
  "spatialCoverage": ["US", "CN"],
  "temporalCoverage": String(ssg.meta.generatedAt || ''),
  "license": "https://tariff-stack.zmarkz123zxc.workers.dev/terms",
  "distribution": [{ "@type": "DataDownload", "encodingFormat": "application/json", "contentUrl": "https://tariff-stack.zmarkz123zxc.workers.dev/data/tariff_full.json" }]
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>TariffStack · HS / HTS Code Encyclopedia</title>
  <meta name="description" content="Every official U.S. HTS and China HS code — real, complete and sourced. Search 25,903 U.S. subheadings and 14,584 China 8-digit codes by code or keyword, with base / MFN rates." />
  <script type="application/ld+json" set:html={jsonLd}></script>
  <script type="application/ld+json" set:html={dsJsonLd}></script>
  <SeoHead />
  <style is:global>
    :root{
      --bg:#f4f6fb; --card:#fff; --text:#1a2233; --muted:#5b6678;
      --accent:#2f6df0; --accent-soft:#e8f0ff; --border:#e2e8f2;
      --good:#10b981; --warn:#f59e0b; --bad:#ef4444; --header-bg:#fff;
      --shadow:0 1px 2px rgba(20,30,60,.06),0 8px 24px rgba(20,30,60,.07);
      --maxw:1180px;
    }
    html[data-theme="dark"]{
      --bg:#0e1320; --card:#161e30; --text:#e6ebf5; --muted:#9aa6bd;
      --accent:#8aa7d8; --accent-soft:#1a2740; --border:#243049; --header-bg:#131a2b;
      --good:#6fbf9c; --warn:#d8a866; --bad:#d88686;
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 -apple-system,"Segoe UI",Roboto,"PingFang SC","Microsoft YaHei",sans-serif;-webkit-font-smoothing:antialiased}
    a{color:var(--accent);text-decoration:none}
    .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
    /* ===== 页头（与首页一致：整条底边带弧） ===== */
    .site-header{background:var(--header-bg);border-radius:0 0 30px 30px;box-shadow:var(--shadow);position:sticky;top:0;z-index:30}
    .site-header .wrap{display:flex;align-items:center;gap:14px;height:64px}
    .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px;letter-spacing:.2px;color:var(--text)}
    .brand .logo{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,var(--accent),#7aa7ff);display:grid;place-items:center;color:#fff;font-size:15px;box-shadow:0 4px 12px rgba(47,109,240,.35)}
    .spacer{flex:1}
    .hbtn{display:inline-flex !important;align-items:center;gap:7px;height:40px;padding:0 16px;border-radius:999px;border:1px solid var(--border);background:var(--card);color:var(--text);font-size:14px;cursor:pointer;transition:.15s;white-space:nowrap;text-decoration:none;visibility:visible !important}
    .hbtn:hover{box-shadow:var(--shadow);transform:translateY(-1px)}
    .hbtn.active{background:var(--accent);border-color:var(--accent);color:#fff}
    .hsep{width:1px;height:24px;background:var(--border);margin:0 2px}
    .hbtn.icon{width:40px;padding:0;justify-content:center}
    select#lang{height:40px;border-radius:999px;border:1px solid var(--border);background:var(--card);color:var(--text);padding:0 12px;font-size:14px;cursor:pointer}
    @media (max-width:1280px){.hbtn{padding:0 12px;font-size:13.5px}}
    @media (max-width:1100px){.hbtn{padding:0 10px;font-size:13px}select#lang{padding:0 8px;font-size:13px}}
    @media (max-width:900px){.site-header .wrap{gap:8px;padding:0 16px}}
    /* ===== Hero ===== */
    .hero{padding:40px 0 8px}
    .hero h1{font-size:32px;margin:0 0 10px;line-height:1.15}
    .hero .sub{color:var(--muted);max-width:680px;margin:0 0 16px}
    .verified{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);background:var(--card);border:1px solid var(--border);border-radius:999px;padding:6px 14px;box-shadow:var(--shadow)}
    .verified .dot{width:8px;height:8px;border-radius:50%;background:var(--good);box-shadow:0 0 0 4px color-mix(in srgb,var(--good) 22%,transparent)}
    /* ===== controls ===== */
    .controls{margin:22px 0 6px;display:flex;flex-wrap:wrap;gap:14px;align-items:center}
    .search{flex:1;min-width:260px;position:relative}
    .search input{width:100%;height:46px;border-radius:12px;border:1px solid var(--border);background:var(--card);color:var(--text);padding:0 14px 0 42px;font-size:15px}
    .search input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
    .search .ico{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:16px}
    .tabs{display:inline-flex;background:var(--card);border:1px solid var(--border);border-radius:999px;padding:4px;gap:4px}
    .tabs button{height:38px;border:none;background:transparent;color:var(--muted);font-size:14px;font-weight:600;border-radius:999px;padding:0 18px;cursor:pointer}
    .tabs button.on{background:var(--accent);color:#fff;box-shadow:var(--shadow)}
    .meta-row{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:14px 0 6px;flex-wrap:wrap}
    .count{font-size:13px;color:var(--muted)}
    .count b{color:var(--text)}
    /* ===== results ===== */
    .results{max-height:62vh;overflow-y:auto;border:1px solid var(--border);border-radius:14px;background:var(--card);box-shadow:var(--shadow)}
    .results::-webkit-scrollbar{width:10px}
    .results::-webkit-scrollbar-thumb{background:var(--border);border-radius:8px;border:2px solid var(--bg)}
    .results::-webkit-scrollbar-track{background:transparent}
    table{width:100%;border-collapse:collapse;font-size:14px;table-layout:auto}
    thead th{position:sticky;top:0;background:var(--card);z-index:2;box-shadow:inset 0 -1px 0 var(--border);text-align:left;padding:12px 14px;color:var(--muted);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.4px}
    tbody td{padding:11px 14px;border-bottom:1px solid var(--border);vertical-align:top}
    tbody tr:last-child td{border-bottom:none}
    tbody tr:hover{background:var(--accent-soft)}
    .code{font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:700;color:var(--accent);font-size:14px;white-space:nowrap;width:120px}
    .desc{color:var(--text);min-width:340px;max-width:560px;white-space:normal;word-break:break-word;line-height:1.5}
    .desc .tr-line{display:block;margin-top:3px;font-size:12.5px;color:var(--accent);opacity:.9;line-height:1.4}
    .tr-line[hidden]{display:none}
    .rate{font-family:ui-monospace,Menlo,Consolas,monospace;text-align:right;white-space:nowrap;font-weight:600;width:120px}
    .rate.free{color:var(--good)}
    .use{text-align:right;white-space:nowrap;width:130px}
    .use a{font-size:13px;font-weight:600;border:1px solid var(--border);border-radius:8px;padding:5px 10px;display:inline-block}
    .use a:hover{background:var(--accent-soft);border-color:var(--accent)}
    .desc .ch{display:inline-block;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11.5px;color:var(--muted);background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:1px 7px;margin-right:8px;font-weight:600;letter-spacing:.5px;vertical-align:1px}
    .empty{padding:40px 14px;text-align:center;color:var(--muted);font-size:14px}
    .note{margin:16px 0 0;font-size:13px;color:var(--muted);line-height:1.6;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 16px}
    .note b{color:var(--text)}
    /* ===== popular (static GEO block: real high-traffic rates in HTML) ===== */
    .popular{margin-top:34px}
    .popular .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
    .popular h2{font-size:19px;margin:0 0 14px;color:var(--text);font-weight:700}
    .popular-box{max-height:none;margin-top:0}
    @media(max-width:560px){.popular .wrap{padding:0 16px}.popular h2{font-size:17px}}
    /* ===== explain (original interpretation, anti low-value) ===== */
    .explain{margin-top:36px;background:var(--card);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow)}
    .explain .wrap{padding:28px 24px 30px}
    .explain h2{margin:0 0 14px;font-size:21px;font-weight:700;color:var(--text);letter-spacing:-.01em}
    .explain p{margin:0 0 12px;font-size:14.5px;line-height:1.7;color:var(--content);max-width:920px}
    .explain p:last-child{margin-bottom:0}
    @media(max-width:560px){.explain .wrap{padding:22px 16px 24px}.explain h2{font-size:19px}}
    /* ===== footer ===== */
    .site-footer{margin-top:48px;background:var(--header-bg);border-top:1px solid var(--border)}
    .footer-inner{max-width:var(--maxw);margin:0 auto;padding:34px 24px 20px;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:28px}
    @media(max-width:820px){.footer-inner{grid-template-columns:1fr 1fr}}
    .site-footer h4{font-size:13px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin:0 0 12px}
    .site-footer ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
    .site-footer a{color:var(--text);text-decoration:none;font-size:14px}
    .site-footer a:hover{color:var(--accent)}
    .site-footer .brand-blurb{color:var(--muted);font-size:13px;max-width:280px;margin:10px 0 0}
    .footer-bottom{max-width:var(--maxw);margin:0 auto;padding:14px 24px;border-top:1px solid var(--border);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:var(--muted);font-size:12.5px}
    @media(max-width:560px){.hero h1{font-size:26px}.results{max-height:70vh}}
  </style>
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/"><span class="logo">⬢</span> TariffStack</a>
      <div class="spacer"></div>
      <a class="hbtn active" href="/hs-codes" data-i18n="hs_enc_btn">HS 编码百科</a>
      <a class="hbtn" href="/guides" data-i18n="guides_btn">关税指南</a>
      <span class="hsep"></span>
      <select id="lang" aria-label="Language">
        {LANGS.map(l => <option value={l.code}>{l.label}</option>)}
      </select>
      <button class="hbtn icon" id="theme-toggle" title="切换主题" aria-label="Toggle dark mode"><span class="tt-ico">🌙</span></button>
    </div>
  </header>

  <section class="hero">
    <div class="wrap">
      <h1 data-i18n="hs_enc_title">HS / HTS Code Encyclopedia</h1>
      <p class="sub" data-i18n="hs_enc_sub">Every official U.S. HTS and China HS code — real, complete, and sourced. Search by code or keyword; rates shown are the official base / MFN rate.</p>
      <span class="verified"><span class="dot"></span> <span data-i18n="badge_pre">✓ Rates verified against official customs data on</span> {verifiedDate} <span data-i18n="badge_tz"> (Beijing time)</span></span>

      <div class="controls">
        <div class="search">
          <span class="ico">🔍</span>
          <input id="q" autocomplete="off" data-i18n-ph="hs_enc_search_ph" placeholder="Search by code (e.g. 6109.10) or keyword (e.g. T-shirt)" />
        </div>
        <div class="tabs">
          <button id="tab-us" class="on" data-i18n="hs_enc_us">United States (HTS)</button>
          <button id="tab-cn" data-i18n="hs_enc_cn">China (HS)</button>
        </div>
      </div>

      <div class="meta-row">
        <span class="count" id="count" set:html={ssgCount}></span>
      </div>

      <div class="results" id="results" set:html={usTable}></div>
      <div id="ssg-cn-data" hidden set:html={cnTable}></div>

      <p class="note"><b data-i18n="hs_enc_note_title">Base rate only.</b> <span data-i18n="hs_enc_note">Shown is the official base / MFN rate. Stacked duties (Section 301, Section 232, UFLPA +12.5%, MPF/HMF) apply per destination — use the calculator for the full landed cost.</span></p>
    </div>
  </section>

  <section class="popular">
    <div class="wrap">
      <h2 data-i18n="hs_popular_h">Popular HS codes — real base rates</h2>
      <div class="results popular-box" id="popular-us" set:html={featUsTable}></div>
      <div id="popular-cn" hidden set:html={featCnTable}></div>
    </div>
  </section>

  <section class="explain">
    <div class="wrap">
      <h2 data-i18n="hs_about_h">How to read these codes</h2>
      <p data-i18n="hs_about_p1">An HS (Harmonized System) code is a 6-digit international standard; the U.S. extends it to a 10-digit HTS subheading and China to an 8-digit HS code. The first two digits are the chapter (broad product group), the next four narrow it to the heading, and the extra digits add national detail. More digits = more precise classification = the rate you actually pay.</p>
      <p data-i18n="hs_about_p2">The rate shown here is the official BASE / MFN rate only — the published duty before any stacked measures. For the U.S., Section 301 (China), Section 232 (steel / aluminium / autos / pharma), the UFLPA +12.5% forced-labour duty, and MPF / HMF fees can all apply on top. For China, the applied rate is the lower of MFN and any provisional / FTA rate. Use the calculator for the full landed cost.</p>
      <p data-i18n="hs_about_p3">Where the numbers come from: U.S. rates are parsed from the official USITC Harmonized Tariff Schedule; China rates from the official 2026 Import & Export Tariff of the State Council Tariff Commission. Every figure is traceable to its source and stamped with an "as of" date so you can verify it yourself.</p>
      <p data-i18n="hs_about_p4">This directory is a search aid, not legal or customs advice. Classification can be contested, and exclusions, AD / CVD, de-minimis thresholds and destination VAT / GST may change your real entry. Always confirm with the destination customs authority or a licensed broker before you file.</p>
    </div>
  </section>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div class="brand"><span class="logo">⬢</span> TariffStack</div>
        <p class="brand-blurb" data-i18n="footer_tagline">Free import-duty & landed-cost calculator — U.S. + China</p>
      </div>
      <div>
        <h4 data-i18n="footer_product">Product</h4>
        <ul>
          <li><a href="/" data-i18n="footer_calc">Calculator</a></li>
          <li><a href="/hs-codes" data-i18n="hs_enc_btn">HS 编码百科</a></li>
          <li><a href="/guides" data-i18n="guides_btn">关税指南</a></li>
        </ul>
      </div>
      <div>
        <h4 data-i18n="footer_legal">Legal</h4>
        <ul>
          <li><a href="/privacy" data-i18n="footer_privacy">Advertising & Privacy</a></li>
          <li><a href="/terms" data-i18n="footer_terms">Terms of Service & Disclaimer</a></li>
          <li><a href="/about" data-i18n="footer_about">About TariffStack</a></li>
        </ul>
      </div>
      <div>
        <h4 data-i18n="footer_contact">Contact</h4>
        <ul>
          <li><a href="/contact" data-i18n="footer_contact_page">Contact page</a></li>
          <li><a href="mailto:TariffStack@outlook.com">TariffStack@outlook.com</a></li>
          <li><a href="mailto:zmarkz123zxc@gmail.com">zmarkz123zxc@gmail.com</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 TariffStack · USITC / 中国海关总署</span>
      <span><a href="/guides" data-i18n="guides_btn">关税指南</a></span>
    </div>
  </footer>

  <CookieConsent />

  <script>
    import { t, LANGS, ensureDescI18n, fillDescTags } from '../lib/i18n.ts';

    let LANG = (localStorage.getItem('ts-lang') || 'en');
    if (!LANGS.some(l => l.code === LANG)) LANG = 'en';

    // ---- theme ----
    (function initTheme(){
      try {
        const saved = localStorage.getItem('ts-theme') || 'light';
        if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        const ico = document.querySelector('#theme-toggle .tt-ico');
        if (ico) ico.textContent = saved === 'dark' ? '☀️' : '🌙';
      } catch (e) {}
    })();
    document.getElementById('theme-toggle').addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      if (next === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      else document.documentElement.removeAttribute('data-theme');
      try { localStorage.setItem('ts-theme', next); } catch (e) {}
      const ico = document.querySelector('#theme-toggle .tt-ico');
      if (ico) ico.textContent = next === 'dark' ? '☀️' : '🌙';
    });

    // ---- minimal i18n ----
    function applyLang(lang) {
      LANG = lang;
      localStorage.setItem('ts-lang', lang);
      document.documentElement.lang = lang;
      document.getElementById('lang').value = lang;
      document.querySelectorAll('[data-i18n]').forEach(e => {
        let s = t(lang, e.getAttribute('data-i18n'));
        if (s) e.textContent = s;
      });
      document.querySelectorAll('[data-i18n-ph]').forEach(e => {
        const k = e.getAttribute('data-i18n-ph'); if (k) e.placeholder = t(lang, k);
      });
      render();
    }
    document.getElementById('lang').addEventListener('change', e => applyLang(e.target.value));

    // ---- data ----
    let US = null;   // dict: code -> {desc, base, ch99, ch99_rate}
    let CN = null;   // dict: code -> {ex, name, mfn, general}
    let TAB = 'US';
    let Q = '';
    const CAP = 200;

    const norm = (s) => (s || '').toLowerCase().replace(/[\s.]/g, '');
    const pct = (x) => {
      const n = Number(x);
      if (!isFinite(n) || n === 0) return { txt: 'Free', free: true };
      return { txt: (n % 1 === 0 ? n : n.toFixed(2)) + '%', free: false };
    };

    // 组合描述（与 build_hs_ssg.mjs 的 composeDesc 保持一致）：沿 HS 层级从 heading 拼到叶子、丢 "Other"、去重、截断兜底
    function composeDesc(dict, leafKey) {
      if (!leafKey || !dict[leafKey]) return '';
      const chain = [leafKey];
      let cur = leafKey;
      while (cur.length > 4) { const i = cur.lastIndexOf('.'); if (i <= 0) break; cur = cur.slice(0, i); chain.unshift(cur); }
      const parts = [];
      for (const k of chain) {
        let s = (dict[k] && dict[k].desc || '').replace(/:\s*$/, '').trim();
        if (!s) continue;
        if (s.length > 100 && !/[.!?:;'"”')\]]$/.test(s)) { const idx = s.lastIndexOf(' '); if (idx > 20) s = s.slice(0, idx) + '…'; }
        if (s.toLowerCase() === 'other') continue;
        if (parts.length && parts[parts.length - 1].toLowerCase() === s.toLowerCase()) continue;
        parts.push(s);
      }
      let out = parts.join(' — ');
      if (!out) { const ch = leafKey.replace(/\./g, '').slice(0, 2); out = `Ch.${ch} Other`; }
      return out;
    }
    function cleanCnName(name) { return (name || '').replace(/^[-–—\s]+/, '').trim(); }

    function dataset() { return TAB === 'US' ? US : CN; }
    function totalCount() { return TAB === 'US' ? (US ? Object.keys(US).length : 0) : (CN ? Object.keys(CN).length : 0); }

    function render() {
      const el = document.getElementById('results');
      const cnt = document.getElementById('count');
      const ds = dataset();
      if (!ds) {
        // 数据 fetch 未完成 → 保留 #results 里的 SSG 200 行真实税率；在 #count 追加轻量加载提示
        if (cnt && !cnt.querySelector('.ts-loading-hint')) {
          const hint = document.createElement('span');
          hint.className = 'ts-loading-hint';
          hint.style.cssText = 'color:var(--muted);margin-left:8px';
          hint.textContent = '· ' + t(LANG, 'hs_enc_loading');
          cnt.appendChild(hint);
        }
        fillDescTags(LANG);
        return;
      }
      const keys = Object.keys(ds);
      const total = keys.length;
      const q = norm(Q);
      let matched = keys;
      if (q) {
        matched = keys.filter(k => {
          const rec = ds[k];
          const text = (TAB === 'US' ? (rec.desc || '') : (rec.name || '')).toLowerCase();
          return norm(k).includes(q) || text.includes(q.toLowerCase());
        });
      }
      const shown = matched.slice(0, CAP);
      const head = TAB === 'US'
        ? `<tr><th data-i18n="hs_enc_code">${t(LANG,'hs_enc_code')}</th><th data-i18n="hs_enc_desc">${t(LANG,'hs_enc_desc')}</th><th class="num" data-i18n="hs_enc_rate">${t(LANG,'hs_enc_rate')}</th><th></th></tr>`
        : `<tr><th data-i18n="hs_enc_code">${t(LANG,'hs_enc_code')}</th><th data-i18n="hs_enc_desc">${t(LANG,'hs_enc_desc')}</th><th class="num" data-i18n="hs_enc_rate">${t(LANG,'hs_enc_rate')}</th><th></th></tr>`;
      const rows = shown.map(k => {
        const rec = ds[k];
        if (TAB === 'US') {
          const r = pct(rec.base * 100);
          const usSrc = composeDesc(US, k) || rec.desc || '';
          return `<tr><td class="code">${k}</td><td class="desc">${esc(usSrc)}<div class="tr-line" data-i18n-desc="${esc(usSrc)}" data-hts="${k}" hidden></div></td><td class="rate ${r.free?'free':''}">${r.txt}</td><td class="use"><a href="/?hts=${encodeURIComponent(k)}&dest=US" data-i18n="hs_enc_use">${t(LANG,'hs_enc_use')}</a></td></tr>`;
        } else {
          const r = pct(rec.mfn);
          // CN data: name is a short dash-prefixed description relative to its parent heading
          // (e.g. "-棉制", "--改良种用", "---其他"). Show it as-is and add a chapter badge for context.
          const chapter = k.slice(0, 4);
          return `<tr><td class="code">${k}</td><td class="desc"><span class="ch">${chapter}</span>${cleanCnName(rec.name)}</td><td class="rate ${r.free?'free':''}">${r.txt}</td><td class="use"><a href="/?hts=${encodeURIComponent(k)}&dest=CN" data-i18n="hs_enc_use">${t(LANG,'hs_enc_use')}</a></td></tr>`;
        }
      }).join('');
      if (!shown.length) {
        el.innerHTML = `<div class="empty" data-i18n="hs_enc_none">${t(LANG,'hs_enc_none')}</div>`;
      } else {
        el.innerHTML = `<table><thead>${head}</thead><tbody>${rows}</tbody></table>`;
      }
      fillDescTags(LANG);
      const label = q
        ? t(LANG,'hs_enc_match').replace('{m}', String(matched.length)).replace('{n}', String(total))
        : t(LANG,'hs_enc_showing').replace('{m}', String(Math.min(shown.length, total))).replace('{n}', String(total));
      cnt.innerHTML = '<b>' + label + '</b>' + (matched.length > CAP ? ' · ' + t(LANG,'hs_enc_more').replace('{cap}', String(CAP)) : '');
    }

    let timer = null;
    document.getElementById('q').addEventListener('input', e => {
      Q = e.target.value;
      clearTimeout(timer);
      timer = setTimeout(render, 120);
    });
    document.getElementById('tab-us').addEventListener('click', () => {
      TAB = 'US'; document.getElementById('tab-us').classList.add('on'); document.getElementById('tab-cn').classList.remove('on');
      render();
    });
    document.getElementById('tab-cn').addEventListener('click', () => {
      TAB = 'CN'; document.getElementById('tab-cn').classList.add('on'); document.getElementById('tab-us').classList.remove('on');
      if (!CN) loadCN(); else render();
    });

    function loadUS() {
      fetch('/data/tariff_full.json').then(r => r.json()).then(j => { US = j; render(); })
        .catch((e) => {
          // 拉取失败：不要清空 #results，SSG 200 行真值保留作为兜底；#count 提示由 render 的 null 分支已加
          console.warn('tariff_full.json failed; SSG subset remains visible', e);
        });
    }
    function loadCN() {
      fetch('/data/tariff_full_cn.json').then(r => r.json()).then(j => { CN = (j && j.by_hs8) ? j.by_hs8 : j; render(); })
        .catch(() => { document.getElementById('results').innerHTML = '<div class="empty">Failed to load China tariff data.</div>'; });
    }

    applyLang(LANG);
    loadUS();
    // 加载描述翻译表，加载完后回填所有译文行（render/fillDescTags 依赖该表）
    ensureDescI18n().then(() => fillDescTags(LANG));
  </script>
</body>
</html>
