        <span class="g-read" data-i18n="g_read">Read the guide →</span>
      </a>
      <a class="g-card" href="/guides/china-retaliatory-tariffs">
        <span class="kicker" data-i18n="g9_kicker">{d.g9_kicker}</span>
        <span class="g-title" data-i18n="g9_title">{d.g9_title}</span>
        <span class="g-desc" data-i18n="g9_desc">{d.g9_desc}</span>
        <span class="g-read" data-i18n="g_read">Read the guide →</span>
      </a>
      <a class="g-card" href="/guides/lookup-hs-codes-walkthrough">
        <span class="kicker" data-i18n="g10_kicker">{d.g10_kicker}</span>
        <span class="g-title" data-i18n="g10_title">{d.g10_title}</span>
        <span class="g-desc" data-i18n="g10_desc">{d.g10_desc}</span>
