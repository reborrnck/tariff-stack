const data = { en, zh, 'zh-TW': en, ja: en, es: en, de: en, ko: en, fr: en, pt: en, it: en };
const lang = 'en';
import overlay from '../data/policy_overlay.json';
const pageUpdated = String(overlay.last_checked || overlay.as_of || '').slice(0, 10) || '2026-09-04';
// 免责声明引用的 USITC HTS 版本号：从 overlay 真实值注入（随 CI 升版自动更新，不写死）
const revNo = String(overlay.base_hts_revision ?? '');
const revDt = String(overlay.base_hts_date || overlay.as_of || '');
const d = en;
d.s13 = d.s13.replace('{rev}', revNo).replace('{date}', revDt);
zh.s13 = zh.s13.replace('{rev}', revNo).replace('{date}', revDt);
const zhS13 = zh.s13;
